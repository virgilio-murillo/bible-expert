 ""}, {"w": "שֶׁ֭קֶר", "l": "שֶׁקֶר", "m": "HNcmsa", "g": "without a cause, deceit(-ful), false(-hood, -ly), feignedly, liar, [phrase] lie, lying, vain (thing), wrongfully.", "s": "H8267", "d": "an untruth; by implication, a sham (often adverbial)", "es": ""}, {"w": "יִשְׂנָ֣א", "l": "שָׂנֵא", "m": "HVqi3ms", "g": "enemy, foe, (be) hate(-ful, -r), odious, [idiom] utterly.", "s": "H8130", "d": "to hate (personally)", "es": ""}, {"w": "צַדִּ֑יק", "l": "צַדִּיק", "m": "HAamsa", "g": "just, lawful, righteous (man).", "s": "H6662", "d": "just", "es": ""}, {"w": "וְ֝/רָשָׁ֗ע", "l": "רָשָׁע", "m": "HC/Aamsa", "g": "[phrase] condemned, guilty, ungodly, wicked (man), that did wrong.", "s": "H7563", "d": "morally wrong; concretely, an (actively) bad person", "es": ""}, {"w": "יַבְאִ֥ישׁ", "l": "בָּאַשׁ", "m": "HVhi3ms", "g": "(make to) be abhorred (had in abomination, loathsome, odious), (cause a, make to) stink(-ing savour), [idiom] utterly.", "s": "H887", "d": "to smell bad; figuratively, to be offensive morally", "es": ""}, {"w": "וְ/יַחְפִּֽיר", "l": "חָפֵר", "m": "HC/Vhi3ms", "g": "be ashamed, be confounded, be brought to confusion (unto shame), come (be put to) shame, bring reproach.", "s": "H2659", "d": "to blush; figuratively, to be ashamed, disappointed; causatively, to shame, reproach", "es": ""}], "6": [{"w": "צְ֭דָקָה", "l": "צְדָקָה", "m": "HNcfsa", "g": "justice, moderately, right(-eous) (act, -ly, -ness).", "s": "H6666", "d": "rightness (abstractly), subjectively (rectitude), objectively (justice), morally (virtue) or figuratively (prosperity)", "es": ""}, {"w": "תִּצֹּ֣ר", "l": "נָצַר", "m": "HVqi3fs", "g": "besieged, hidden thing, keep(-er, -ing), monument, observe, preserve(-r), subtil, watcher(-man).", "s": "H5341", "d": "to guard, in a good sense (to protect, maintain, obey, etc.) or a bad one (to conceal, etc.)", "es": ""}, {"w": "תָּם", "l": "תֹּם", "m": "HNcmsc", "g": "full, integrity, perfect(-ion), simplicity, upright(-ly, -ness), at a venture. See H8550 (תֻּמִּים).", "s": "H8537", "d": "completeness; figuratively, prosperity; usually (morally) innocence", "es": ""}, {"w": "דָּ֑רֶךְ", "l": "דֶּרֶךְ", "m": "HNcbsa", "g": "along, away, because of, [phrase] by, conversation, custom, (east-) ward, journey, manner, passenger, through, toward, (high-) (path-) way(-side)", "s": "H1870", "d": "a road (as trodden); figuratively, a course of life or mode of action, often adverb", "es": ""}, {"w": "וְ֝/רִשְׁעָ֗ה", "l": "רִשְׁעָה", "m": "HC/Ncfsa", "g": "fault, wickedly(-ness).", "s": "H7564", "d": "wrong (especially moral)", "es": ""}, {"w": "תְּסַלֵּ֥ף", "l": "סָלַף", "m": "HVpi3fs", "g": "overthrow, pervert.", "s": "H5557", "d": "properly, to wrench, i.e. (figuratively) to subvert", "es": ""}, {"w": "חַטָּֽאת", "l": "חַטָּאָה", "m": "HNcfsa", "g": "punishment (of sin), purifying(-fication for sin), sin(-ner, offering).", "s": "H2403", "d": "an offence (sometimes habitual sinfulness), and its penalty, occasion, sacrifice, or expiation; also (concretely) an offender", "es": ""}], "7": [{"w": "יֵ֣שׁ", "l": "יֵשׁ", "m": "HTm", "g": "(there) are, (he, it, shall, there, there may, there shall, there should) be, thou do, had, hast, (which) hath, (I, shalt, that) have, (he, it", "s": "H3426", "d": "there is or are (or any other form of the verb to be, as may suit the connection)", "es": ""}, {"w": "מִ֭תְעַשֵּׁר", "l": "עָשַׁר", "m": "HVtrmsa", "g": "be(-come, en-, make, make self, wax) rich, make (1 Kings 22:48 marg). See H6240 (עָשָׂר).", "s": "H6238", "d": "properly, to accumulate; chiefly (specifically) to grow (causatively, make) rich", "es": ""}, {"w": "וְ/אֵ֣ין", "l": "אַיִן", "m": "HC/Tn", "g": "else, except, fail, (father-) less, be gone, in(-curable), neither, never, no (where), none, nor, (any, thing), not, nothing, to nought, past", "s": "H369", "d": "a non-entity; generally used as a negative particle", "es": ""}, {"w": "כֹּ֑ל", "l": "כֹּל", "m": "HNcmsa", "g": "(in) all (manner, (ye)), altogether, any (manner), enough, every (one, place, thing), howsoever, as many as, (no-) thing, ought, whatsoever", "s": "H3605", "d": "properly, the whole; hence, all, any or every (in the singular only, but often in a plural sense)", "es": ""}, {"w": "מִ֝תְרוֹשֵׁ֗שׁ", "l": "רוּשׁ", "m": "HVrrmsa", "g": "lack, needy, (make self) poor (man).", "s": "H7326", "d": "to be destitute", "es": ""}, {"w": "וְ/ה֣וֹן", "l": "הוֹן", "m": "HC/Ncmsa", "g": "enough, [phrase] for nought, riches, substance, wealth.", "s": "H1952", "d": "wealth; by implication, enough", "es": ""}, {"w": "רָֽב", "l": "רַב", "m": "HAamsa", "g": "(in) abound(-undance, -ant, -antly), captain, elder, enough, exceedingly, full, great(-ly, man, one), increase, long (enough, (time)), (do", "s": "H7227", "d": "abundant (in quantity, size, age, number, rank, quality)", "es": ""}], "8": [{"w": "כֹּ֣פֶר", "l": "כֹּפֶר", "m": "HNcmsc", "g": "bribe, camphire, pitch, ransom, satisfaction, sum of money, village.", "s": "H3724", "d": "properly, a cover, i.e. (literally) a village (as covered in); (specifically) bitumen (as used for coating), and the henna plant (as used for dyeing); figuratively, a redemption-price", "es": ""}, {"w": "נֶֽפֶשׁ", "l": "נֶפֶשׁ", "m": "HNcbsc", "g": "any, appetite, beast, body, breath, creature, [idiom] dead(-ly), desire, [idiom] (dis-) contented, [idiom] fish, ghost, [phrase] greedy, he", "s": "H5315", "d": "properly, a breathing creature, i.e. animal of (abstractly) vitality; used very widely in a literal, accommodated or figurative sense (bodily or mental)", "es": ""}, {"w": "אִ֣ישׁ", "l": "אִישׁ", "m": "HNcmsa", "g": "also, another, any (man), a certain, [phrase] champion, consent, each, every (one), fellow, (foot-, husband-) man, (good-, great, mighty) man, he", "s": "H376", "d": "a man as an individual or a male person; often used as an adjunct to a more definite term (and in such cases frequently not expressed in translation)", "es": ""}, {"w": "עָשְׁר֑/וֹ", "l": "עֹשֶׁר", "m": "HNcmsc/Sp3ms", "g": "[idiom] 