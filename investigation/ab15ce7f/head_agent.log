### Phase 3: Add Keyboard Navigation to OT

Add to `_build_unified_body`:

```javascript
let currentVerse = 1;
// IntersectionObserver to track visible verse
const observer = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) currentVerse = parseInt(e.target.id.replace('vb','')) || currentVerse; });
}, {threshold: 0.3});
document.querySelectorAll('.verse-block').forEach(vb => observer.observe(vb));

document.addEventListener('keydown', function(e) {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
    if (e.key === 'j' || e.key === 'J') { currentVerse = Math.min(currentVerse + 1, VERSE_COUNT); document.getElementById('vb' + currentVerse)?.scrollIntoView({behavior:'smooth',block:'start'}); }
    if (e.key === 'k' || e.key === 'K') { currentVerse = Math.max(currentVerse - 1, 1); document.getElementById('vb' + currentVerse)?.scrollIntoView({behavior:'smooth',block:'start'}); }
    if (e.key === 'r' || e.key === 'R') { toggleRVR(currentVerse); }
    if (e.key === 'e' || e.key === 'E') { toggleSection('exeg-'+currentVerse); }
    if (e.key === 'p' || e.key === 'P') { toggleSection('patr-'+currentVerse); }
    if (e.key === 'x' || e.key === 'X') { document.getElementById('xref-'+currentVerse)?.classList.toggle('collapsed'); }
});
```

