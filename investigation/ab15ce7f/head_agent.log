body.dark .spanish-line { color: #bbb; }
body.dark .ver-line { color: #bbb; }
body.dark .ver-label { color: #90caf9; }
body.dark .section-toggle { color: #e0e0e0; }
body.dark .section-toggle:hover { background: #2a2a2a; }
