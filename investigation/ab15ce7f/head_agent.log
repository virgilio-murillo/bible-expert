le="background:#eee"></td><td class="tc-word-cell tc-interactive" style="background:#f5f5f5" data-tip="el" data-lemma="ὁ" data-morph="T-NSM" data-strongs="G3588">ὁ</td><td class="tc-word-cell tc-interactive" style="background:#f5f5f5" data-tip="Hijo" data-lemma="υἱός" data-morph="N-NSM" data-strongs="G5207">Υἱὸς</td></tr><tr><td class="tc-ms-cell" onclick="showMSSPanel('ita, ff2c vgmss syrpalmss (syrpalms ὁ μονογενὴς υἱός) copsa οὗτος … θεοῦ Mt 3:17; 17:5; 27:54; Mk 9:7; 15:39; Lk 9:35; Jn 20:31; Ac 9:20')"><span class="ms-chip" style="background:#f3e5f5;color:#6a1b9a" data-s="ita" onclick="event.stopPropagation();showMSInfo(this,'ita');">ita</span><span class="ms-chip" style="background:#f3e5f5;color:#6a1b9a" data-s="vgmss" onclick="event.stopPropagation();showMSInfo(this,'vgmss');">vgmss</span><span class="ms-chip" style="background:#f3e5f5;color:#6a1b9a" data-s="syrpalmss" onclick="event.stopPropagation();showMSInfo(this,'syrpalmss');">syrpalmss</span><span class="ms-chip" style="background:#f3e5f5;color:#6a1b9a" data-s="syrpalms" onclick="event.stopPropagation();showMSInfo(this,'syrpalms');">syrpalms</span><span class="ms-chip" style="background:#f3e5f5;color:#6a1b9a" data-s="copsa" onclick="event.stopPropagation();showMSInfo(this,'copsa');">copsa</span></td><td class="tc-word-cell tc-interactive" style="background:#f5f5f5" data-tip="y" data-lemma="καί" data-morph="CONJ" data-strongs="G2532">καὶ</td><td class="tc-word-cell tc-interactive" style="background:#f5f5f5" data-tip="he dado testimonio" data-lemma="μαρτυρέω" data-morph="V-RAI-1S" data-strongs="G3140">μεμαρτύρηκα</td><td class="tc-word-cell tc-interactive" style="background:#c8e6c9" data-tip="el" data-lemma="ὁ" data-morph="T-NSM" data-strongs="G3588">ὁ</td><td class="tc-word-cell tc-interactive" style="background:#c8e6c9" data-tip="" data-lemma="" data-morph="" data-strongs="">ἐκλεκτὸς</td><td class="tc-word-cell tc-interactive" style="background:#c8e6c9" data-tip="hijo" data-lemma="υἱός" data-morph="N-NSM" data-strongs="G5207">υἱός</td><td class="tc-word-cell tc-interactive" style="background:#f5f5f5" data-tip="el" data-lemma="ὁ" data-morph="T-NSM" data-strongs="G3588">ὁ</td><td class="tc-word-cell tc-interactive" style="background:#f5f5f5" data-tip="Hijo" data-lemma="υἱός" data-morph="N-NSM" data-strongs="G5207">Υἱὸς</td></tr></table></div><div style="font-size:0.72rem;color:#555;margin:0.3rem 0;padding:0.3rem 0.5rem;background:#f5f5f5;border-radius:4px"><strong>Lecturas:</strong> <span style="margin-right:0.8rem">#1: <span style="font-family:serif;color:#1b5e20">ὁ υἱός</span></span><span style="margin-right:0.8rem">#2: <span style="font-family:serif;color:#1b5e20">ὁ ἐκλεκτός</span></span><span style="margin-right:0.8rem">#3: <span style="font-family:serif;color:#1b5e20">ὁ ἐκλεκτὸς υἱός</span></span></div><div style="font-size:0.63rem;color:#999;margin-top:2px;display:flex;gap:0.5rem;flex-wrap:wrap"><span style="font-weight:600">MSS:</span> <span>🔴 Papiros</span> <span>🔵 Unciales</span> <span>⚪ Minúsc.</span> <span>🟣 Versiones</span> <span>🟠 Padres</span> <span>🟢 Byz/Lect</span></div><div class="tc-criteria-expanded"><div class="tc-criterion-item"><strong>Atestación temprana</strong><div class="tc-criterion-exp">Los manuscritos papiráceos más antiguos apoyan consistentemente 'υἱός'. La variante 'ἐκλεκτός' aparece principalmente en manuscritos occidentales y algunas versiones.</div></div><div class="tc-criterion-item"><strong>Fórmula estereotipada</strong><div class="tc-criterion-exp">La expresión 'Hijo de Dios' es la fórmula cristológica estándar en Juan y el Nuevo Testamento. 'Elegido' sería una desviación inusual de este patrón establecido.</div></div></div><div style="font-size:0.72rem;color:#1565c0;margin-top:0.5rem;cursor:pointer" onclick="document.getElementById('exeg-34')?.classList.remove('collapsed');document.getElementById('exeg-34')?.scrollIntoView({behavior:'smooth'})">↑ Ver análisis exegético de este versículo</div><div style="margin-top:0.8rem;text-align:center"><a href="tc_deep_dive_John_1_34.html" onclick="if(!this.dataset.ready){this.textContent='⏳ Generando análisis profundo...';this.style.opacity=0.6;return true;}" style="display:inline-block;padding:8px 20px;background:linear-gradient(135deg,#1a237e,#0d47a1);color:white;border-radius:8px;text-decoration:none;font-size:0.85rem;font-weight:600;box-shadow:0 2px 8px rgba(26,35,126,0.3)">🔍 Deep Dive — Análisis completo de esta variante</a><div style="font-size:0.7rem;color:#888;margin-top:3px">Si la página no existe, usa el tool <code>critical_apparatus</code> → <code>tc_deep_dive</code> en el MCP server para generarla.</div></div></div></div><div class="verse-block" id="vb35"><div class="verse-header"><span class="vnum">35</span></div><div class="greek-line" id="greek-35">Τῇ ἐπαύριον πάλιν εἱστήκει ὁ Ἰωάννης καὶ ἐκ τῶν μαθητῶν αὐτοῦ δύο</div><div class="uncial-line" id="uncial-35" style="display:none;font-family:'Noto Serif',serif;font-size:0.9rem;letter-spacing:1.5px;color:#5d4037;background:#efebe9;padding:6px 10px;border-radius:4px;margin-bottom:0.3rem;overflow-wrap:break-word" title="Así se vería este versículo en un manuscrito uncial del siglo IV — todo mayúsculas, sin espacios (puntos medios añadidos como ayuda visual)">ΤΗΙ·ΕΠΑΥΡΙΟΝ·ΠΑΛΙΝ·ΕΙΣΤΗΚΕΙ·Ο·ΙΩΑΝΝΗΣ·ΚΑΙ·ΕΚ·ΤΩΝ·ΜΑΘΗΤΩΝ·ΑΥΤΟΥ·ΔΥΟ<span style="display:block;font-size:0.65rem;margin-top:4px;letter-spacing:0;opacity:0.7"><a href="https://www.codexsinaiticus.org/en/manuscript.aspx?book=33&chapter=1&verse=35" target="_blank" style="color:#5d4037">Ver en Codex Sinaiticus →</a></span></div><div style="display:flex;gap:0.3rem;flex-wrap:wrap;margin-bottom:0.3rem;align-items:center"><div class="rvr-btn" onclick="toggleRVR(35)">RVR60</div><div class="rvr-btn" onclick="document.getElementById('uncial-35').style.display=document.getElementById('uncial-35').style.display==='none'?'':'none'" style="background:#efebe9;color:#5d4037;border-color:#bcaaa4" title="Escritura uncial: así se veía el NT en los manuscritos del s.IV (Vaticanus, Sinaiticus). Todo mayúsculas, sin espacios entre palabras (scriptio continua), sin acentos ni puntuación. La iota subscrita se escribe explícitamente.">Uncial</div><div class="rvr-btn" onclick="document.getElementById('pron-35').style.display=document.getElementById('pron-35').style.display==='none'?'':'none'" style="background:#e3f2fd;color:#1565c0;border-color:#90caf9" title="Pronunciación bizantina aproximada (griego moderno/eclesiástico)">Pronunciación</div><div class="rvr-btn vbtn-patr" onclick="toggleSection('patr-35')" title="8 citas patrísticas disponibles">✝ 8 patrística</div><div class="rvr-btn vbtn-exeg" onclick="toggleSection('exeg-35')" title="3 comentarios exegéticos">📚 3 exégesis</div><div class="rvr-btn vbtn-ver" onclick="document.getElementById('vers-35').classList.toggle('collapsed')" title="9 versiones disponibles">📖 versiones</div><div class="rvr-btn" onclick="copyVerse(35)" title="Copiar versículo al portapapeles" style="background:#f3e5f5;border-color:#ce93d8;color:#6a1b9a">📋</div><div class="rvr-btn" onclick="document.getElementById('notes-35').style.display=document.getElementById('notes-35').style.display==='none'?'':'none'" title="Notas personales" style="background:#fff8e1;border-color:#ffd54f;color:#f57f17">📝</div></div><div id="rvr-35" class="collapsed spanish-line">El siguiente día otra vez estaba Juan, y dos de sus discípulos.</div><div id="vers-35" class="collapsed" style="margin-bottom:0.5rem"><div class="ver-line"><span class="ver-label">RVR60</span>El siguiente día otra vez estaba Juan, y dos de sus discípulos.</div><div class="ver-line"><span class="ver-label">RVR1909</span>El siguiente día otra vez estaba Juan, y dos de sus discípulos.</div><div class="ver-line"><span class="ver-label">KJV</span>Again the next day after John stood, and two of his disciples;</div><div class="ver-line"><span class="ver-label">ASV</span>Again on the morrow John was standing, and two of his disciples; </div><div class="ver-line"><span class="ver-label">BSB</span>  The next day John was there again with two of his disciples. </div><div class="ver-line"><span class="ver-label">Darby</span>Again, on the morrow, there stood John and two of his disciples. </div><div class="ver-line"><span class="ver-label">LITV</span>Again on the morrow, John and two from his disciples stood. </div><div class="ver-line"><span class="ver-label">YLT</span>On the morrow, again, John was standing, and two of his disciples,</div><div class="ver-line"><span class="ver-label">Vulgate</span>altera die iterum stabat Iohannes et ex discipulis eius duo</div></div><div id="pron-35" style="display:none;font-size:0.85rem;color:#1565c0;background:#e3f2fd;padding:4px 8px;border-radius:4px;margin-bottom:0.3rem;font-style:italic" class="pron-line"></div><div id="notes-35" style="display:none;margin-bottom:0.5rem"><textarea id="note-input-35" style="width:100%;min-height:50px;border:1px solid #ccc;border-radius:6px;padding:4px 8px;font-size:0.82rem;resize:vertical" placeholder="Tus notas para v.35..." oninput="saveNote(35)"></textarea></div><div class="section-toggle" onclick="toggleSection('exeg-35')" role="button" aria-expanded="false" aria-controls="exeg-35" tabindex="0"><span class="section-icon">📜</span> Exégesis del Griego <span class="arrow" id="arrow-exeg-35">▶</span></div><div id="exeg-35" class="collapsed section-content exeg-section" role="region"><div class="exeg-summary"><strong style="color:#1b5e20">Alford:</strong> Rather, what they then heard seems to have made a powerful impression on their minds, so that the repetition of the notice is now the signal for them to follow Jesus.<br><strong style="color:#1b5e20">Bengel:</strong> τῇ ἐπαύριον , on the following day ) Great days! The first the day of the record borne as to Jesus being Messiah ; [John 1:15-16] ; the second, the day of his testimony concerning the same Person, and…<br><strong style="color:#1b5e20">Robertson:</strong> Again on the morrow ( τη επαυριον παλιν ).<br></div><div class="comm-item"><div class="comm-header" onclick="document.getElementById('uexv35_0').classList.toggle('collapsed')"><strong>Alford's Greek Testament</strong> <span style=color:#888;font-size:0.75rem>(1863)</span><span class="small-arrow">ver completo ▼</span></div><div id="uexv35_0" class="collapsed comm-body">35. τῇ ἐπ . ] See on [John 1:29] . I can hardly suppose with De Wette, that these two had been absent on the preceding day. Rather, what they then heard seems to have made a powerful impression on their minds, so that the repetition of the notice is now the signal for them to follow Jesus. (On the second disciple, see below on [John 1:41] .)</div></div><div class="comm-item"><div class="comm-header" onclick="document.getElementById('uexv35_1').classList.toggle('collapsed')"><strong>Bengel's Gnomon</strong> <span style=color:#888;font-size:0.75rem>(1742)</span><span class="small-arrow">ver completo ▼</span></div><div id="uexv35_1" class="collapsed comm-body">[John 1:35] . τῇ ἐπαύριον , on the following day ) Great days! The first the day of the record borne as to Jesus being Messiah ; [John 1:15-16] ; the second, the day of his testimony concerning the same Person, and at the same time as to His suffering [passion]; [John 1:29-30] ; the third, this day, that of the three disciples joining Him; the fourth, that of Philip and Nathanael being brought over to Him, [John 1:43] . Add ch. [John 2:1] ; [John 2:12] [on the third day; after this He went to Capernaum, etc., and continued there not many days]. The care of this Evangelist in marking times is remarkable. δυό , two ) about to be witnesses.</div></div><div class="comm-item"><div class="comm-header" onclick="document.getElementById('uexv35_2').classList.toggle('collapsed')"><strong>Robertson's Word Pictures</strong> <span style=color:#888;font-size:0.75rem>(1933)</span><span class="small-arrow">ver completo ▼</span></div><div id="uexv35_2" class="collapsed comm-body">Again on the morrow ( τη επαυριον παλιν ). Third day since verse [John 1:19]. Was standing ( ιστηκε ). Past perfect of ιστημ , intransitive, and used as imperfect in sense. See same form in [John 7:37]. Two ( δυο ). One was Andrew (verse [John 1:40]), the other the Beloved Disciple (the Apostle John), who records this incident with happy memories.</div></div></div><div class="section-toggle" onclick="toggleSection('patr-35')" role="button" aria-expanded="false" aria-controls="patr-35" tabindex="0"><span class="section-icon">👨‍🏫</span> Patrística · 2 temas · 8 citas <span class="arrow" id="arrow-patr-35">▶</span></div><div id="patr-35" class="collapsed section-content patr-section" role="region"><div class="patr-theme"><div class="patr-theme-header" onclick="document.getElementById('pt85640f10').classList.toggle('collapsed');this.querySelector('.arrow').classList.toggle('open')"><strong>Cristo como el Cordero de Dios</strong><div class="consensus-bar" style="width:60px"><div style="width:85%;background:#4caf50"></div></div><span class="consensus-label" style="color:#4caf50">alto</span><span class="arrow">▼</span></div><div id="pt85640f10" class="collapsed" style="padding:0.5rem 0.2rem 0"><div class="patr-citation" style="border-left-color:#4caf50"><div class="patr-cite-header">✅ <strong>Augustine of Hippo</strong> (s.IV-V (354-430)) <span class="patr-meta">— Obispo de Hipona, Doctor de la Iglesia, discípulo de Ambrosio de Milán (Hipona)</span> <a href="https://es.wikipedia.org/wiki/Agust%C3%ADn_de_Hipona" target="_blank" class="patr-link">📖</a> <span class="patr-verse-ref">[v.35]</span></div><div class="patr-cite-text">"Assuredly, in a special sense, the Lamb; for the disciples were also called lambs: "Behold, I send you as lambs in the midst of wolves." They were also called light: "Ye are the light of the world;" but in another sense is He called so, concerning whom it was said, "That was the true light, which lighteth every man that cometh into the world.""</div></div><div class="patr-citation" style="border-left-color:#4caf50"><div class="patr-cite-header">✅ <strong>John Chrysostom</strong> (s.IV (c.349-407)) <span class="patr-meta">— Patriarca de Constantinopla, "Boca de Oro", discípulo de Diodoro de Tarso (Antioquía/Constantinopla)</span> <a href="https://es.wikipedia.org/wiki/Juan_Cris%C3%B3stomo" target="_blank" class="patr-link">📖</a> <span class="patr-verse-ref">[v.36]</span></div><div class="patr-cite-text">"As then The Word shows us His pre-eminence, and The Son His superiority in comparison with others, so "The Lamb, The Christ, that Prophet, the True Light, the Good Shepherd," and whatever other names are applied to Him with the addition of the article, mark a great difference. For there were many "Lambs," and "Prophets," and "Christs," and "sons," but from all these John separates Him by a wide interval."</div></div><div class="patr-citation" style="border-left-color:#4caf50"><div class="patr-cite-header">✅ <strong>Cyril of Alexandria</strong> (s.V (c.376-444)) <span class="patr-meta">— Patriarca de Alejandría, Concilio de Éfeso (Alejandría)</span> <a href="https://es.wikipedia.org/wiki/Cirilo_de_Alejandr%C3%ADa" target="_blank" class="patr-link">📖</a> <span class="patr-verse-ref">[v.36]</span></div><div class="patr-cite-text">"Already had the blessed Baptist pointed Him out before; but lo, repeating again the same words, he points Jesus out to his disciples, and calls Him the Lamb of God, and says that He taketh away the sin of the world, all but bringing his hearers to remembrance of Him Who saith in the Prophets: I, even I, am He That blotteth"</div></div><div class="patr-resumen">Los Padres enfatizan que Cristo es "el" Cordero de Dios en sentido único y especial, distinguiéndolo de otros que también pueden llamarse corderos. Su función es quitar el pecado del mundo.</div></div></div><div class="patr-theme"><div class="patr-theme-header" onclick="document.getElementById('pt1d70daf2').classList.toggle('collapsed');this.querySelector('.arrow').classList.toggle('open')"><strong>Juan el Bautista como amigo del Esposo</strong><div class="consensus-bar" style="width:60px"><div style="width:85%;background:#4caf50"></div></div><span class="consensus-label" style="color:#4caf50">alto</span><span class="arrow">▼</span></div><div id="pt1d70daf2" class="collapsed" style="padding:0.5rem 0.2rem 0"><div class="patr-citation" style="border-left-color:#4caf50"><div class="patr-cite-header">✅ <strong>Augustine of Hippo</strong> (s.IV-V (354-430)) <span class="patr-meta">— Obispo de Hipona, Doctor de la Iglesia, discípulo de Ambrosio de Milán (Hipona)</span> <a href="https://es.wikipedia.org/wiki/Agust%C3%ADn_de_Hipona" target="_blank" class="patr-link">📖</a> <span class="patr-verse-ref">[v.35]</span></div><div class="patr-cite-text">"John was the friend of the Bridegroom; he sought not his own glory, but bare witness to the truth. And therefore he wished not his disciples to remain with him, to the hindrance of their duty to follow the Lord; but rather showed them whom they should follow, saying, Behold the Lamb of God."</div></div><div class="patr-citation" style="border-left-color:#4caf50"><div class="patr-cite-header">✅ <strong>John Chrysostom</strong> (s.IV (c.349-407)) <span class="patr-meta">— Patriarca de Constantinopla, "Boca de Oro", discípulo de Diodoro de Tarso (Antioquía/Constantinopla)</span> <a href="https://es.wikipedia.org/wiki/Juan_Cris%C3%B3stomo" target="_blank" class="patr-link">📖</a> <span class="patr-verse-ref">[v.35]</span></div><div class="patr-cite-text">"Christ utters no word, His messenger saith all. So it is with a bridegroom. He saith not for a while anything to the bride, but is there in silence, while some show him to the bride, and others give her into his hands; she merely appears, and he departs not having taken her himself, but when he has received her from another who gives her to him."</div></div><div class="patr-resumen">Los Padres interpretan el papel de Juan como el amigo del Esposo que presenta la esposa (los discípulos) a Cristo. Juan no busca su propia gloria sino dirigir a otros hacia Jesús.</div></div></div></div></div><div class="verse-block" id="vb36"><div class="verse-header"><span class="vnum">36</span></div><div class="greek-line" id="greek-36">καὶ ἐμβλέψας τῷ Ἰησοῦ περιπατοῦντι λέγει Ἴδε ὁ Ἀμνὸς τοῦ Θεοῦ</div><div class="uncial-line" id="uncial-36" style="display:none;font-family:'Noto Serif',serif;font-size:0.9rem;letter-spacing:1.5px;color:#5d4037;background:#efebe9;padding:6px 10px;border-radius:4px;margin-bottom:0.3rem;overflow-wrap:break-word" title="Así se vería este versículo en un manuscrito uncial del siglo IV — todo mayúsculas, sin espacios (puntos medios añadidos como ayuda visual)">ΚΑΙ·ΕΜΒΛΕΨΑΣ·ΤΩΙ·ΙΗΣΟΥ·ΠΕΡΙΠΑΤΟΥΝΤΙ·ΛΕΓΕΙ·ΙΔΕ·Ο·ΑΜΝΟΣ·ΤΟΥ·ΘΕΟΥ<span style="display:block;font-size:0.65rem;margin-top:4px;letter-spacing:0;opacity:0.7"><a href="https://www.codexsinaiticus.org/en/manuscript.aspx?book=33&chapter=1&verse=36" target="_blank" style="color:#5d4037">Ver en Codex Sinaiticus →</a></span></div><div style="display:flex;gap:0.3rem;flex-wrap:wrap;margin-bottom:0.3rem;align-items:center"><div class="rvr-btn" onclick="toggleRVR(36)">RVR60</div><div class="rvr-btn" onclick="document.getElementById('uncial-36').style.display=document.getElementById('uncial-36').style.display==='none'?'':'none'" style="background:#efebe9;color:#5d4037;border-color:#bcaaa4" title="Escritura uncial: así se veía el NT en los manuscritos del s.IV (Vaticanus, Sinaiticus). Todo mayúsculas, sin espacios entre palabras (scriptio continua), sin acentos ni puntuación. La iota subscrita se escribe explícitamente.">Uncial</div><div class="rvr-btn" onclick="document.getElementById('pron-36').style.display=document.getElementById('pron-36').style.display==='none'?'':'none'" style="background:#e3f2fd;color:#1565c0;border-color:#90caf9" title="Pronunciación bizantina aproximada (griego moderno/eclesiástico)">Pronunciación</div><div class="rvr-btn vbtn-patr" onclick="toggleSection('patr-36')" title="7 citas patrísticas disponibles">✝ 7 patrística</div><div class="rvr-btn vbtn-exeg" onclick="toggleSection('exeg-36')" title="2 comentarios exegéticos">📚 2 exégesis</div><div class="rvr-btn vbtn-ver" onclick="document.getElementById('vers-36').classList.toggle('collapsed')" title="9 versiones disponibles">📖 versiones</div><div class="rvr-btn" onclick="document.getElementById('xrefs-36').classList.toggle('collapsed')" title="1 referencias cruzadas">🔗 1 refs</div><div class="rvr-btn" onclick="copyVerse(36)" title="Copiar versículo al portapapeles" style="background:#f3e5f5;border-color:#ce93d8;color:#6a1b9a">📋</div><div class="rvr-btn" onclick="document.getElementById('notes-36').style.display=document.getElementById('notes-36').style.display==='none'?'':'none'" title="Notas personales" style="background:#fff8e1;border-color:#ffd54f;color:#f57f17">📝</div></div><div id="rvr-36" class="collapsed spanish-line">Y mirando a Jesús que andaba por allí, dijo: He aquí el Cordero de Dios.</div><div id="vers-36" class="collapsed" style="margin-bottom:0.5rem"><div class="ver-line"><span class="ver-label">RVR60</span>Y mirando a Jesús que andaba por allí, dijo: He aquí el Cordero de Dios.</div><div class="ver-line"><span class="ver-label">RVR1909</span>Y mirando á Jesús que andaba por allí, dijo: He aquí el Cordero de Dios.</div><div class="ver-line"><span class="ver-label">KJV</span>And looking upon Jesus as he walked, he saith, Behold the Lamb of God!</div><div class="ver-line"><span class="ver-label">ASV</span>and he looked upon Jesus as he walked, and saith, Behold, the Lamb of God! </div><div class="ver-line"><span class="ver-label">BSB</span>When he saw Jesus walking by, he said, “Look, the Lamb of God!” </div><div class="ver-line"><span class="ver-label">Darby</span>And, looking at Jesus as he walked, he says, Behold the Lamb ofGod. </div><div class="ver-line"><span class="ver-label">LITV</span>And looking at Jesus walking, he said, Behold, the Lamb of God!   </div><div class="ver-line"><span class="ver-label">YLT</span>and having looked on Jesus walking, he saith, `Lo, the Lamb of God;'</div><div class="ver-line"><span class="ver-label">Vulgate</span>et respiciens Iesum ambulantem dicit ecce agnus Dei</div></div><div id="xrefs-36" class="collapsed xref-container" style="margin-bottom:0.5rem"><span class="xref-pill" onclick="showXrefPopup(this)" data-ref="John 1:29" data-es="El siguiente día ve Juan á Jesús que venía á él, y dice: He aquí el Cordero de Dios, que quita el pecado del mundo." data-gr="Τῇ ἐπαύριον βλέπει τὸν Ἰησοῦν ἐρχόμενον πρὸς αὐτόν, καὶ λέγει· Ἴδε ὁ ἀμνὸς τοῦ θεοῦ ὁ αἴρων τὴν ἁμαρτίαν τοῦ κόσμου." data-lxx="" title="El siguiente día ve Juan á Jesús que venía á él, y dice: He aquí el Cordero de D…">John 1:29</span></div><div id="pron-36" style="display:none;font-size:0.85rem;color:#1565c0;background:#e3f2fd;padding:4px 8px;border-radius:4px;margin-bottom:0.3rem;font-style:italic" class="pron-line"></div><div id="notes-36" style="display:none;margin-bottom:0.5rem"><textarea id="note-input-36" style="width:100%;min-height:50px;border:1px solid #ccc;border-radius:6px;padding:4px 8px;font-size:0.82rem;resize:vertical" placeholder="Tus notas para v.36..." oninput="saveNote(36)"></textarea></div><div class="section-toggle" onclick="toggleSection('exeg-36')" role="button" aria-expanded="false" aria-controls="exeg-36" tabindex="0"><span class="section-icon">📜</span> Exégesis del Griego <span class="arrow" id="arrow-exeg-36">▶</span></div><div id="exeg-36" class="collapsed section-content exeg-section" role="region"><div class="exeg-summary"><strong style="color:#1b5e20">Bengel:</strong> Περιπατοῦντι , as He walked ) He was not now coming to John, as He was, [John 1:29] : for [to have come] oftener, would not have been becoming.<br><strong style="color:#1b5e20">Robertson:</strong> Present active participle in dative case after εμβλεψας and like ερχομενον in verse [John 1:29] vividly pictures the rapture of John in this vision of Jesus, so far as we know the third and last glimp…<br></div><div class="comm-item"><div class="comm-header" onclick="document.getElementById('uexv36_0').classList.toggle('collapsed')"><strong>Bengel's Gnomon</strong> <span style=color:#888;font-size:0.75rem>(1742)</span><span class="small-arrow">ver completo ▼</span></div><div id="uexv36_0" class="collapsed comm-body">[John 1:36] . Περιπατοῦντι , as He walked ) He was not now coming to John, as He was, [John 1:29] : for [to have come] oftener, would not have been becoming. To have done so once was condescension enough.</div></div><div class="comm-item"><div class="comm-header" onclick="document.getElementById('uexv36_1').classList.toggle('collapsed')"><strong>Robertson's Word Pictures</strong> <span style=color:#888;font-size:0.75rem>(1933)</span><span class="small-arrow">ver completo ▼</span></div><div id="uexv36_1" class="collapsed comm-body">He looked ( εμβλεψας ). First aorist active participle of εμβλεπω , antecedent action before λεγε (says). As he walked ( περιπατουντ ). Present active participle in dative case after εμβλεψας and like ερχομενον in verse [John 1:29] vividly pictures the rapture of John in this vision of Jesus, so far as we know the third and last glimpse of Jesus by John (the baptism, verse [John 1:29], and here). Saith ( λεγε ). Historical present, change from ιστηκε before. He repeats part of the tribute in verse [John 1:29].</div></div></div><div class="section-toggle" onclick="toggleSection('patr-36')" role="button" aria-expanded="false" aria-controls="patr-36" tabindex="0"><span class="section-icon">👨‍🏫</span> Patrística · 1 temas · 7 citas <span class="arrow" id="arrow-patr-36">▶</span></div><div id="patr-36" class="collapsed section-content patr-section" role="region"><div class="patr-theme"><div class="patr-theme-header" onclick="document.getElementById('pt9751fe31').classList.toggle('collapsed');this.querySelector('.arrow').classList.toggle('open')"><strong>Cristo como el Cordero de Dios</strong><div class="consensus-bar" style="width:60px"><div style="width:85%;background:#4caf50"></div></div><span class="consensus-label" style="color:#4caf50">alto</span><span class="arrow">▼</span></div><div id="pt9751fe31" class="collapsed" style="padding:0.5rem 0.2rem 0"><div class="patr-citation" style="border-left-color:#4caf50"><div class="patr-cite-header">✅ <strong>Augustine of Hippo</strong> (s.IV-V (354-430)) <span class="patr-meta">— Obispo de Hipona, Doctor de la Iglesia, discípulo de Ambrosio de Milán (Hipona)</span> <a href="https://es.wikipedia.org/wiki/Agust%C3%ADn_de_Hipona" target="_blank" class="patr-link">📖</a> <span class="patr-verse-ref">[v.35]</span></div><div class="patr-cite-text">"Assuredly, in a special sense, the Lamb; for the disciples were also called lambs: "Behold, I send you as lambs in the midst of wolves." They were also called light: "Ye are the light of the world;" but in another sense is He called so, concerning whom it was said, "That was the true light, which lighteth every man that cometh into the world.""</div></div><div class="patr-citation" style="border-left-color:#4caf50"><div class="patr-cite-header">✅ <strong>John Chrysostom</strong> (s.IV (c.349-407)) <span class="patr-meta">— Patriarca de Constantinopla, "Boca de Oro", discípulo de Diodoro de Tarso (Antioquía/Constantinopla)</span> <a href="https://es.wikipedia.org/wiki/Juan_Cris%C3%B3stomo" target="_blank" class="patr-link">📖</a> <span class="patr-verse-ref">[v.36]</span></div><div class="patr-cite-text">"As then The Word shows us His pre-eminence, and The Son His superiority in comparison with others, so "The Lamb, The Christ, that Prophet, the True Light, the Good Shepherd," and whatever other names are applied to Him with the addition of the article, mark a great difference. For there were many "Lambs," and "Prophets," and "Christs," and "sons," but from all these John separates Him by a wide interval."</div></div><div class="patr-citation" style="border-left-color:#4caf50"><div class="patr-cite-header">✅ <strong>Cyril of Alexandria</strong> (s.V (c.376-444)) <span class="patr-meta">— Patriarca de Alejandría, Concilio de Éfeso (Alejandría)</span> <a href="https://es.wikipedia.org/wiki/Cirilo_de_Alejandr%C3%ADa" target="_blank" class="patr-link">📖</a> <span class="patr-verse-ref">[v.36]</span></div><div class="patr-cite-text">"Already had the blessed Baptist pointed Him out before; but lo, repeating again the same words, he points Jesus out to his disciples, and calls Him the Lamb of God, and says that He taketh away the sin of the world, all but bringing his hearers to remembrance of Him Who saith in the Prophets: I, even I, am He That blotteth"</div></div><div class="patr-resumen">Los Padres enfatizan que Cristo es "el" Cordero de Dios en sentido único y especial, distinguiéndolo de otros que también pueden llamarse corderos. Su función es quitar el pecado del mundo.</div></div></div></div></div><div class="verse-block" id="vb37"><div class="verse-header"><span class="vnum">37</span></div><div class="greek-line" id="greek-37">καὶ ἤκουσαν οἱ δύο μαθηταὶ αὐτοῦ λαλοῦντος καὶ ἠκολούθησαν τῷ Ἰησοῦ</div><div class="uncial-line" id="uncial-37" style="display:none;font-family:'Noto Serif',serif;font-size:0.9rem;letter-spacing:1.5px;color:#5d4037;background:#efebe9;padding:6px 10px;border-radius:4px;margin-bottom:0.3rem;overflow-wrap:break-word" title="Así se vería este versículo en un manuscrito uncial del siglo IV — todo mayúsculas, sin espacios (puntos medios añadidos como ayuda visual)">ΚΑΙ·ΗΚΟΥΣΑΝ·ΟΙ·ΔΥΟ·ΜΑΘΗΤΑΙ·ΑΥΤΟΥ·ΛΑΛΟΥΝΤΟΣ·ΚΑΙ·ΗΚΟΛΟΥΘΗΣΑΝ·ΤΩΙ·ΙΗΣΟΥ<span style="display:block;font-size:0.65rem;margin-top:4px;letter-spacing:0;opacity:0.7"><a href="https://www.codexsinaiticus.org/en/manuscript.aspx?book=33&chapter=1&verse=37" target="_blank" style="color:#5d4037">Ver en Codex Sinaiticus →</a></span></div><div style="display:flex;gap:0.3rem;flex-wrap:wrap;margin-bottom:0.3rem;align-items:center"><div class="rvr-btn" onclick="toggleRVR(37)">RVR60</div><div class="rvr-btn" onclick="document.getElementById('uncial-37').style.display=document.getElementById('uncial-37').style.display==='none'?'':'none'" style="background:#efebe9;color:#5d4037;border-color:#bcaaa4" title="Escritura uncial: así se veía el NT en los manuscritos del s.IV (Vaticanus, Sinaiticus). Todo mayúsculas, sin espacios entre palabras (scriptio continua), sin acentos ni puntuación. La iota subscrita se escribe explícitamente.">Uncial</div><div class="rvr-btn" onclick="document.getElementById('pron-37').style.display=document.getElementById('pron-37').style.display==='none'?'':'none'" style="background:#e3f2fd;color:#1565c0;border-color:#90caf9" title="Pronunciación bizantina aproximada (griego moderno/eclesiástico)">Pronunciación</div><div class="rvr-btn vbtn-patr" onclick="toggleSection('patr-37')" title="8 citas patrísticas disponibles">✝ 8 patrística</div><div class="rvr-btn vbtn-exeg" onclick="toggleSection('exeg-37')" title="3 comentarios exegéticos">📚 3 exégesis</div><div class="rvr-btn vbtn-ver" onclick="document.getElementById('vers-37').classList.toggle('collapsed')" title="9 versiones disponibles">📖 versiones</div><div class="rvr-btn" onclick="copyVerse(37)" title="Copiar versículo al portapapeles" style="background:#f3e5f5;border-color:#ce93d8;color:#6a1b9a">📋</div><div class="rvr-btn" onclick="document.getElementById('notes-37').style.display=document.getElementById('notes-37').style.display==='none'?'':'none'" title="Notas personales" style="background:#fff8e1;border-color:#ffd54f;color:#f57f17">📝</div></div><div id="rvr-37" class="collapsed spanish-line">Le oyeron hablar los dos discípulos, y siguieron a Jesús.</div><div id="vers-37" class="collapsed" style="margin-bottom:0.5rem"><div class="ver-line"><span class="ver-label">RVR60</span>Le oyeron hablar los dos discípulos, y siguieron a Jesús.</div><div class="ver-line"><span class="ver-label">RVR1909</span>Y oyéronle los dos discípulos hablar, y siguieron á Jesús.</div><div class="ver-line"><span class="ver-label">KJV</span>And the two disciples heard him speak, and they followed Jesus.</div><div class="ver-line"><span class="ver-label">ASV</span>And the two disciples heard him speak, and they followed Jesus. </div><div class="ver-line"><span class="ver-label">BSB</span>And when the two disciples heard him say this, they followed Jesus. </div><div class="ver-line"><span class="ver-label">Darby</span>And the two disciples heard him speaking, and followed Jesus. </div><div class="ver-line"><span class="ver-label">LITV</span>And the two disciples heard him speaking, and they followed Jesus. </div><div class="ver-line"><span class="ver-label">YLT</span>and the two disciples heard him speaking, and they followed Jesus.</div><div class="ver-line"><span class="ver-label">Vulgate</span>et audierunt eum duo discipuli loquentem et secuti sunt Iesum</div></div><div id="pron-37" style="display:none;font-size:0.85rem;color:#1565c0;background:#e3f2fd;padding:4px 8px;border-radius:4px;margin-bottom:0.3rem;font-style:italic" class="pron-line"></div><div id="notes-37" style="display:none;margin-bottom:0.5rem"><textarea id="note-input-37" style="width:100%;min-height:50px;border:1px solid #ccc;border-radius:6px;padding:4px 8px;font-size:0.82rem;resize:vertical" placeholder="Tus notas para v.37..." oninput="saveNote(37)"></textarea></div><div class="section-toggle" onclick="toggleSection('exeg-37')" role="button" aria-expanded="false" aria-controls="exeg-37" tabindex="0"><span class="section-icon">📜</span> Exégesis del Griego <span class="arrow" id="arrow-exeg-37">▶</span></div><div id="exeg-37" class="collapsed section-content exeg-section" role="region"><div class="exeg-summary"><strong style="color:#1b5e20">Alford:</strong> in the narrower sense which it bears when they left all and followed Him; but here only of mechanical going after Him, βουλόμενοι πεῖραν λαβεῖν αὐτοῦ , Euthym [33] [33] Euthymius Zigabenus, 1116.<br><strong style="color:#1b5e20">Bengel:</strong> Ἠκολούθησαν , followed ) of their own accord from behind.<br><strong style="color:#1b5e20">Robertson:</strong> Heard him speak ( ηκουσαν αυτου λαλουντος ).<br></div><div class="comm-item"><div class="comm-header" onclick="document.getElementById('uexv37_0').classList.toggle('collapsed')"><strong>Alford's Greek Testament</strong> <span style=color:#888;font-size:0.75rem>(1863)</span><span class="small-arrow">ver completo ▼</span></div><div id="uexv37_0" class="collapsed comm-body">37. ] We must not understand ἠκολ . in the narrower sense which it bears when they left all and followed Him; but here only of mechanical going after Him, βουλόμενοι πεῖραν λαβεῖν αὐτοῦ , Euthym [33] [33] Euthymius Zigabenus, 1116</div></div><div class="comm-item"><div class="comm-header" onclick="document.getElementById('uexv37_1').classList.toggle('collapsed')"><strong>Bengel's Gnomon</strong> <span style=color:#888;font-size:0.75rem>(1742)</span><span class="small-arrow">ver completo ▼</span></div><div id="uexv37_1" class="collapsed comm-body">[John 1:37] . Ἠκολούθησαν , followed ) of their own accord from behind. [Here were] the first commencements of the Christian Church. At the beginning Jesus invited disciples with a kind of milk-like [&lsquo;lacteâ,&rsquo; alluring] sweetness. [ You will not find that He appointed certain hours for instructing disciples; but all His conversation presented [the aspect of one] continued instruction and lasting training, at one time the handle [for instruction] being given by a marriage; at another time, in overwhelming straits on the water; at another time in a case of household need; at another time when some one was sick; at another time, on the occasion of some lapse on the part of the disciples. Immediately, as it were, on the highway (before the public, and on the spot &ldquo;in trivio&rdquo;) He taught, reproved, bent, bore with, admonished, tried, strengthened, established them, and opened out to them one part of the truth after another, and freed them from one false conception after another, commencing from these first [ earliest ] times all along to His ascension . Harm ., p. 157.]</div></div><div class="comm-item"><div class="comm-header" onclick="document.getElementById('uexv37_2').classList.toggle('collapsed')"><strong>Robertson's Word Pictures</strong> <span style=color:#888;font-size:0.75rem>(1933)</span><span class="small-arrow">ver completo ▼</span></div><div id="uexv37_2" class="collapsed comm-body">Heard him speak ( ηκουσαν αυτου λαλουντος ). First active indicative of ακουω and present active participle of λαλεω in genitive case agreeing with αυτου , object of ακουω . "Heard him speaking" (kind of indirect discourse). John had disciples ( μαθητα , learners, from μανθανω , to learn). They followed Jesus ( ηκολουθησαν τω Ιησου ). Associative instrumental case after verb (first aorist active indicative, ingressive aorist, of ακολουθεω ). These two disciples of the Baptist (Andrew and John) took him at his word and acted on it. John the Baptist had predicted and portrayed the Messiah, had baptized him, had interpreted him, and now for the second time had identified him.</div></div><div class="themes-divider">🔍 Temas discutidos</div><div class="theme-card"><div class="theme-word">ἠκολούθησαν</div><div class="consensus-bar"><div style="width:85%;background:#4caf50"></div></div><div class="opinion" style="border-left-color:#4caf50">✅ <strong>Alford</strong> No debe entenderse en el sentido estrecho de dejar todo y seguirle, sino solo ir mecánicamente tras él para probarlo</div><div class="opinion" style="border-left-color:#ff9800">⚠️ <strong>Bengel</strong> Siguieron por su propia voluntad desde atrás, marcando los primeros comienzos de la Iglesia cristiana</div><div class="opinion" style="border-left-color:#4caf50">✅ <strong>Robertson</strong> Aoristo ingresivo, estos dos discípulos del Bautista tomaron su palabra y actuaron sobre ella</div><div class="theme-summary">Los comentaristas concuerdan en que fue un seguimiento inicial e investigativo, no el llamado formal posterior.</div></div></div><div class="section-toggle" onclick="toggleSection('patr-37')" role="button" aria-expanded="false" aria-controls="patr-37" tabindex="0"><span class="section-icon">👨‍🏫</span> Patrística · 1 temas · 8 citas <span class="arrow" id="arrow-patr-37">▶</span></div><div id="patr-37" class="collapsed section-content patr-section" role="region"><div class="patr-theme"><div class="patr-theme-header" onclick="document.getElementById('pt4b61f73a').classList.toggle('collapsed');this.querySelector('.arrow').classList.toggle('open')"><strong>La conversión de los primeros discípulos</strong><div class="consensus-bar" style="width:60px"><div style="width:85%;background:#4caf50"></div></div><span class="consensus-label" style="color:#4caf50">alto</span><span class="arrow">▼</span></div><div id="pt4b61f73a" class="collapsed" style="padding:0.5rem 0.2rem 0"><div class="patr-citation" style="border-left-color:#4caf50"><div class="patr-cite-header">✅ <strong>Ephrem the Syrian</strong> (s.IV (c.306-373)) <span class="patr-meta">— Diácono, poeta teológico (Nísibis/Edesa)</span> <a href="https://es.wikipedia.org/wiki/Efr%C3%A9n_el_Sirio" target="_blank" class="patr-link">📖</a> <span class="patr-verse-ref">[v.37]</span></div><div class="patr-cite-text">"Because the disciples of John heard him when he spoke about our Lord, they left their teacher and went after our Lord, because [John's] voice was not able to keep the disciples with him [John], but it sent them to the Word. It was indeed right that when the light of the sun came into view, the light of the lamp should vanish."</div></div><div class="patr-citation" style="border-left-color:#ff9800"><div class="patr-cite-header">⚠️ <strong>John Chrysostom</strong> (s.IV (c.349-407)) <span class="patr-meta">— Patriarca de Constantinopla, "Boca de Oro", discípulo de Diodoro de Tarso (Antioquía/Constantinopla)</span> <a href="https://es.wikipedia.org/wiki/Juan_Cris%C3%B3stomo" target="_blank" class="patr-link">📖</a> <span class="patr-verse-ref">[v.37]</span></div><div class="patr-cite-text">"Yet John had other disciples, but they not only did not "follow Jesus," but were even jealously disposed towards him. "Rabbi," says one, "He that was with thee beyond Jordan, to whom thou barest witness, behold, the same baptizeth, and all men come unto him." And again they appear bringing a charge against him; "Why do we fast, but thy disciples fast not?" But those who were better than the rest had no such feeling, but heard, and at once f"</div></div><div class="patr-citation" style="border-left-color:#4caf50"><div class="patr-cite-header">✅ <strong>Cyril of Alexandria</strong> (s.V (c.376-444)) <span class="patr-meta">— Patriarca de Alejandría, Concilio de Éfeso (Alejandría)</span> <a href="https://es.wikipedia.org/wiki/Cirilo_de_Alejandr%C3%ADa" target="_blank" class="patr-link">📖</a> <span class="patr-verse-ref">[v.37]</span></div><div class="patr-cite-text">"Seest thou the fruit, handmaid of teaching, yielded therefrom? Seest thou how great gain accrued from repetition? Let him then who is entrusted with teaching learn from this, to show himself superior to all indolence, and to esteem silence more hurtful to himself than to his hearers"</div></div><div class="patr-resumen">Los Padres ven la conversión de los discípulos como fruto del testimonio repetido de Juan. Algunos discípulos respondieron positivamente mientras otros permanecieron celosos.</div></div></div></div></div><div class="verse-block" id="vb38"><div class="verse-header"><span class="vnum">38</span> <span style="font-size:0.65rem;color:#c62828;font-weight:600" title="Palabras de Cristo (Verba Christi)">✝</span></div><div class="greek-line" id="greek-38" style="color:#c62828">Στραφεὶς δὲ ὁ Ἰησοῦς καὶ θεασάμενος αὐτοὺς ἀκολουθοῦντας λέγει αὐτοῖς Τί ζητεῖτε Οἱ δὲ εἶπαν αὐτῷ Ῥαββί ὃ λέγεται μεθερμηνευόμενον Διδάσκαλε Ποῦ μένεις</div><div class="uncial-line" id="uncial-38" style="display:none;font-family:'Noto Serif',serif;font-size:0.9rem;letter-spacing:1.5px;color:#5d4037;background:#efebe9;padding:6px 10px;border-radius:4px;margin-bottom:0.3rem;overflow-wrap:break-word" title="Así se vería este versículo en un manuscrito uncial del siglo IV — todo mayúsculas, sin espacios (puntos medios añadidos como ayuda visual)">ΣΤΡΑΦΕΙΣ·ΔΕ·Ο·ΙΗΣΟΥΣ·ΚΑΙ·ΘΕΑΣΑΜΕΝΟΣ·ΑΥΤΟΥΣ·ΑΚΟΛΟΥΘΟΥΝΤΑΣ·ΛΕΓΕΙ·ΑΥΤΟΙΣ·ΤΙ·ΖΗΤΕΙΤΕ·ΟΙ·ΔΕ·ΕΙΠΑΝ·ΑΥΤΩΙ·ΡΑΒΒΙ·Ο·ΛΕΓΕΤΑΙ·ΜΕΘΕΡΜΗΝΕΥΟΜΕΝΟΝ·ΔΙΔΑΣΚΑΛΕ·ΠΟΥ·ΜΕΝΕΙΣ<span style="display:block;font-size:0.65rem;margin-top:4px;letter-spacing:0;opacity:0.7"><a href="https://www.codexsinaiticus.org/en/manuscript.aspx?book=33&chapter=1&verse=38" target="_blank" style="color:#5d4037">Ver en Codex Sinaiticus →</a></span></div><div style="display:flex;gap:0.3rem;flex-wrap:wrap;margin-bottom:0.3rem;align-items:center"><div class="rvr-btn" onclick="toggleRVR(38)">RVR60</div><div class="rvr-btn" onclick="document.getElementById('uncial-38').style.display=document.getElementById('uncial-38').style.display==='none'?'':'none'" style="background:#efebe9;color:#5d4037;border-color:#bcaaa4" title="Escritura uncial: así se veía el NT en los manuscritos del s.IV (Vaticanus, Sinaiticus). Todo mayúsculas, sin espacios entre palabras (scriptio continua), sin acentos ni puntuación. La iota subscrita se escribe explícitamente.">Uncial</div><div class="rvr-btn" onclick="document.getElementById('pron-38').style.display=document.getElementById('pron-38').style.display==='none'?'':'none'" style="background:#e3f2fd;color:#1565c0;border-color:#90caf9" title="Pronunciación bizantina aproximada (griego moderno/eclesiástico)">Pronunciación</div><div class="rvr-btn vbtn-patr" onclick="toggleSection('patr-38')" title="8 citas patrísticas disponibles">✝ 8 patrística</div><div class="rvr-btn vbtn-exeg" onclick="toggleSection('exeg-38')" title="2 comentarios exegéticos">📚 2 exégesis</div><div class="rvr-btn vbtn-ver" onclick="document.getElementById('vers-38').classList.toggle('collapsed')" title="9 versiones disponibles">📖 versiones</div><div class="rvr-btn" onclick="copyVerse(38)" title="Copiar versículo al portapapeles" style="background:#f3e5f5;border-color:#ce93d8;color:#6a1b9a">📋</div><div class="rvr-btn" onclick="document.getElementById('notes-38').style.display=document.getElementById('notes-38').style.display==='none'?'':'none'" title="Notas personales" style="background:#fff8e1;border-color:#ffd54f;color:#f57f17">📝</div></div><div id="rvr-38" class="collapsed spanish-line" style="color:#c62828">Y volviéndose Jesús, y viendo que le seguían, les dijo: ¿Qué buscáis? Ellos le dijeron: Rabí (que traducido es, Maestro), ¿dónde moras?</div><div id="vers-38" class="collapsed" style="margin-bottom:0.5rem"><div class="ver-line"><span class="ver-label">RVR60</span>Y volviéndose Jesús, y viendo que le seguían, les dijo: ¿Qué buscáis? Ellos le dijeron: Rabí (que traducido es, Maestro), ¿dónde moras?</div><div class="ver-line"><span class="ver-label">RVR1909</span>Y volviéndose Jesús, y viéndolos seguir le, díceles: ¿Qué buscáis? Y ellos le dijeron: Rabbí (que declarado quiere decir Maestro) ¿dónde moras?</div><div class="ver-line"><span class="ver-label">KJV</span>Then Jesus turned, and saw them following, and saith unto them, What seek ye? They said unto him, Rabbi, (which is to say, being interpreted, Master,) where dwellest thou?</div><div class="ver-line"><span class="ver-label">ASV</span>And Jesus turned, and beheld them following, and saith unto them, What seek ye? And they said unto him, Rabbi (which is to say, being interpreted, Teacher), where abidest thou? </div><div class="ver-line"><span class="ver-label">BSB</span>Jesus turned and saw them following. “What do you want?” He asked.  They said to Him, “Rabbi” (which means Teacher), “where are You staying?” </div><div class="ver-line"><span class="ver-label">Darby</span>But Jesus having turned, and seeing them following, says to them, What seek ye? And they said to him, Rabbi (which, being interpreted, signifies Teacher), where abidest thou? </div><div class="ver-line"><span class="ver-label">LITV</span>But having seen them following, Jesus said to them, What do you seek? And they said to Him, Rabbi (which being translated is called Teacher), where do You stay? </div><div class="ver-line"><span class="ver-label">YLT</span>And Jesus having turned, and having beheld them following, saith to them, `What seek ye?' and they said to them, `Rabbi, (which is, being interpreted, Teacher,) where remainest thou?'</div><div class="ver-line"><span class="ver-label">Vulgate</span>conversus autem Iesus et videns eos sequentes dicit eis quid quaeritis qui dixerunt ei rabbi quod dicitur interpretatum magister ubi habitas</div></div><div id="pron-38" style="display:none;font-size:0.85rem;color:#1565c0;background:#e3f2fd;padding:4px 8px;border-radius:4px;margin-bottom:0.3rem;font-style:italic" class="pron-line"></div><div id="notes-38" style="display:none;margin-bottom:0.5rem"><textarea id="note-input-38" style="width:100%;min-height:50px;border:1px solid #ccc;border-radius:6px;padding:4px 8px;font-size:0.82rem;resize:vertical" placeholder="Tus notas para v.38..." oninput="saveNote(38)"></textarea></div><div class="section-toggle" onclick="toggleSection('exeg-38')" role="button" aria-expanded="false" aria-controls="exeg-38" tabindex="0"><span class="section-icon">📜</span> Exégesis del Griego <span class="arrow" id="arrow-exeg-38">▶</span></div><div id="exeg-38" class="collapsed section-content exeg-section" role="region"><div class="exeg-summary"><strong style="color:#1b5e20">Bengel:</strong> Τὶ ζητεῖτε , what seek ye? ) He was aware it was Himself they sought.<br><strong style="color:#1b5e20">Robertson:</strong> John's Gospel has the disciples at first addressing Jesus by Rabbi while others address him by Κυριε (Lord or Sir) as in [John 4:11]; [John 4:49]; [John 5:7].<br></div><div class="comm-item"><div class="comm-header" onclick="document.getElementById('uexv38_0').classList.toggle('collapsed')"><strong>Bengel's Gnomon</strong> <span style=color:#888;font-size:0.75rem>(1742)</span><span class="small-arrow">ver completo ▼</span></div><div id="uexv38_0" class="collapsed comm-body">[John 1:38] . Τὶ ζητεῖτε , what seek ye? ) He was aware it was Himself they sought. He means therefore. What seek ye with Me? not, Whom seek ye? By this question He touched their heart. He showed that He knew that they were seeking something; and He gives them the opportunity of begging [from Him] what they would. Ῥαββί , Rabbi ) Seasonably they give this title to Jesus; [John 1:49] . [39] Also the interpretation being added, shows that the disciples assigned it to Him in the restricted signification. ποῦ μένεις ) we ask, where thou art stopping , where thou hast thy μονή [mansion, residence]. They are desirous of His intimacy. [39] i.e. as ver. 40. Nathanael there addressed Jesus, in consequence of learning His omniscience in having seen Him under the fig-tree, Rabbi , etc.: so here, ver. 38, the disciples give Him the same title for the same reason, viz. their learning His omniscience, as extending to the knowledge of their thoughts and what they were seeking . E. and T.</div></div><div class="comm-item"><div class="comm-header" onclick="document.getElementById('uexv38_1').classList.toggle('collapsed')"><strong>Robertson's Word Pictures</strong> <span style=color:#888;font-size:0.75rem>(1933)</span><span class="small-arrow">ver completo ▼</span></div><div id="uexv38_1" class="collapsed comm-body">Turned ( στραφεις ). Second aorist passive participle of στρεφω , vividly picturing the sudden act of Jesus on hearing their steps behind him. Beheld ( θεασαμενος ). First aorist middle participle of θεαομα (verse [John 1:32]). Both participles here express antecedent action to λεγε (saith). Following ( ακολοθουντας ). Present active participle of ακολουθεω (verse [John 1:37]). It was Christ's first experience of this kind and the two came from the Baptist to Jesus. What seek ye? ( Τ ζητειτε; ). Not "whom" ( τινα [John 18:4]; [John 20:15]), but "what purpose have you." The first words of Jesus preserved in this Gospel. See [Luke 2:49]; [Matthew 3:15] for words spoken before this and [Mark 1:15] for Mark's first report in the Galilean ministry. Rabbi ( Ραββε ). Aramaic title for "Teacher" which John here translates by Διδασκαλε as he is writing late and for general readers. Luke, a Greek Christian, does not use it, but John recalls his first use of this term to Jesus and explains it. Matthew has it only in the greeting of Judas to the Master ([Matthew 26:25]; [Matthew 26:49]) and Mark once by Judas ([Mark 14:45]) and twice by Peter ([Mark 9:5]; [Mark 11:21]). John's Gospel has the disciples at first addressing Jesus by Rabbi while others address him by Κυριε (Lord or Sir) as in [John 4:11]; [John 4:49]; [John 5:7]. Peter uses Κυριε in [John 6:68]. In the end the disciples usually say Κυριε ([John 13:6]; [John 13:25], etc.), but Mary Magdalene says Ραββουνε ([John 20:16]). Being interpreted ( μεθερμημευομενον ). Present passive participle of μεθερμηνευω , late compound of μετα and ερμηνευω , to explain ([John 1:42]), old word from Hερμες , the god of speech (hermeneutics). John often explains Aramaic words ([John 1:38]; [John 1:41]; [John 1:42]; [John 4:25]; [John 9:7], etc.). Where abidest thou? ( Που μενεισ; ). They wished a place for quiet converse with Jesus.</div></div></div><div class="section-toggle" onclick="toggleSection('patr-38')" role="button" aria-expanded="false" aria-controls="patr-38" tabindex="0"><span class="section-icon">👨‍🏫</span> Patrística · 2 temas · 8 citas <span class="arrow" id="arrow-patr-38">▶</span></div><div id="patr-38" class="collapsed section-content patr-section" role="region"><div class="patr-theme"><div class="patr-theme-header" onclick="document.getElementById('pt998583fa').classList.toggle('collapsed');this.querySelector('.arrow').classList.toggle('open')"><strong>El diálogo de Jesús con los primeros discípulos</strong><div class="consensus-bar" style="width:60px"><div style="width:85%;background:#4caf50"></div></div><span class="consensus-label" style="color:#4caf50">alto</span><span class="arrow">▼</span></div><div id="pt998583fa" class="collapsed" style="padding:0.5rem 0.2rem 0"><div class="patr-citation" style="border-left-color:#4caf50"><div class="patr-cite-header">✅ <strong>John Chrysostom</strong> (s.IV (c.349-407)) <span class="patr-meta">— Patriarca de Constantinopla, "Boca de Oro", discípulo de Diodoro de Tarso (Antioquía/Constantinopla)</span> <a href="https://es.wikipedia.org/wiki/Juan_Cris%C3%B3stomo" target="_blank" class="patr-link">📖</a> <span class="patr-verse-ref">[v.38]</span></div><div class="patr-cite-text">"Hence we are taught, that God does not prevent our wills by His gifts, but that when we begin, when we provide the being willing, then He gives us many opportunities of salvation. "What seek ye?" How is this? He who knoweth the hearts of men, who dwelleth in our thoughts, doth He ask? He doth; not that He may be informed; how could that be? but that by the question He may make them more familiar"</div></div><div class="patr-citation" style="border-left-color:#4caf50"><div class="patr-cite-header">✅ <strong>Cyril of Alexandria</strong> (s.V (c.376-444)) <span class="patr-meta">— Patriarca de Alejandría, Concilio de Éfeso (Alejandría)</span> <a href="https://es.wikipedia.org/wiki/Cirilo_de_Alejandr%C3%ADa" target="_blank" class="patr-link">📖</a> <span class="patr-verse-ref">[v.38]</span></div><div class="patr-cite-text">"Like people well instructed do they that are asked reply. For already do they call Him, Master, thereby clearly signifying their readiness to learn. Then they beg to know His home, as about therein to tell Him at a fit season of their need. For probably they did not think it right to make talk on needful subjects the companion of a journey."</div></div><div class="patr-citation" style="border-left-color:#4caf50"><div class="patr-cite-header">✅ <strong>Theodore of Mopsuestia</strong> (s.IV-V (c.350-428)) <span class="patr-meta">— Obispo, exégeta antioqueno, discípulo de Diodoro de Tarso (Mopsuestia)</span> <a href="https://es.wikipedia.org/wiki/Teodoro_de_Mopsuestia" target="_blank" class="patr-link">📖</a> <span class="patr-verse-ref">[v.38]</span></div><div class="patr-cite-text">"He did not say this out of ignorance but rather in order to give them an occasion to trust him. They immediately called him "Rabbi" and showed their profound intention, that is, that they had been led to Jesus for no other reason but the desire to obey him as a teacher."</div></div><div class="patr-resumen">Los Padres interpretan la pregunta de Jesús "¿Qué buscáis?" no como ignorancia sino como pedagogía divina para crear familiaridad y dar oportunidad de expresar su deseo de aprender.</div></div></div><div class="patr-theme"><div class="patr-theme-header" onclick="document.getElementById('pt711e7a82').classList.toggle('collapsed');this.querySelector('.arrow').classList.toggle('open')"><strong>El significado de la décima hora</strong><div class="consensus-bar" style="width:60px"><div style="width:55%;background:#ff9800"></div></div><span class="consensus-label" style="color:#ff9800">medio</span><span class="arrow">▼</span></div><div id="pt711e7a82" class="collapsed" style="padding:0.5rem 0.2rem 0"><div class="patr-citation" style="border-left-color:#4caf50"><div class="patr-cite-header">✅ <strong>Augustine of Hippo</strong> (s.IV-V (354-430)) <span class="patr-meta">— Obispo de Hipona, Doctor de la Iglesia, discípulo de Ambrosio de Milán (Hipona)</span> <a href="https://es.wikipedia.org/wiki/Agust%C3%ADn_de_Hipona" target="_blank" class="patr-link">📖</a> <span class="patr-verse-ref">[v.38]</span></div><div class="patr-cite-text">"Do we think that it did in no wise pertain to the evangelist to tell us what hour it was? Is it possible that he wished us to give heed to nothing in that, to inquire after nothing? It was the tenth hour. That number signifies the law, because the law was given in ten commandments."</div></div><div class="patr-citation" style="border-left-color:#4caf50"><div class="patr-cite-header">✅ <strong>Augustine of Hippo</strong> (s.IV-V (354-430)) <span class="patr-meta">— Obispo de Hipona, Doctor de la Iglesia, discípulo de Ambrosio de Milán (Hipona)</span> <a href="https://es.wikipedia.org/wiki/Agust%C3%ADn_de_Hipona" target="_blank" class="patr-link">📖</a> <span class="patr-verse-ref">[v.39]</span></div><div class="patr-cite-text">"The number here signifies the law, which was composed of ten commandments. The time had come when the law was to be fulfilled by love, the Jews, who acted from fear, having been unable to fulfil it, and therefore was it at the tenth hour that our Lord heard Himself called, Rabbi"</div></div><div class="patr-resumen">Agustín propone una interpretación simbólica de la décima hora como referencia a los diez mandamientos y el cumplimiento de la ley por el amor. Otros Padres no desarrollan esta interpretación específica.</div></div></div></div></div><div class="verse-block" id="vb39"><div class="verse-header"><span class="vnum">39</span> <span style="font-size:0.65rem;color:#c62828;font-weight:600" title="Palabras de Cristo (Verba Christi)">✝</span></div><div class="greek-line" id="greek-39" style="color:#c62828">Λέγει αὐτοῖς Ἔρχεσθε καὶ ὄψεσθε ἦλθαν οὖν καὶ εἶδαν ποῦ μένει καὶ παρ᾽ αὐτῷ ἔμειναν τὴν ἡμέραν ἐκείνην ὥρα ἦν ὡς δεκάτη</div><div class="uncial-line" id="uncial-39" style="display:none;font-family:'Noto Serif',serif;font-size:0.9rem;letter-spacing:1.5px;color:#5d4037;background:#efebe9;padding:6px 10px;border-radius:4px;margin-bottom:0.3rem;overflow-wrap:break-word" title="Así se vería este versículo en un manuscrito uncial del siglo IV — todo mayúsculas, sin espacios (puntos medios añadidos como ayuda visual)">ΛΕΓΕΙ·ΑΥΤΟΙΣ·ΕΡΧΕΣΘΕ·ΚΑΙ·ΟΨΕΣΘΕ·ΗΛΘΑΝ·ΟΥΝ·ΚΑΙ·ΕΙΔΑΝ·ΠΟΥ·ΜΕΝΕΙ·ΚΑΙ·ΠΑΡ·ΑΥΤΩΙ·ΕΜΕΙΝΑΝ·ΤΗΝ·ΗΜΕΡΑΝ·ΕΚΕΙΝΗΝ·ΩΡΑ·ΗΝ·ΩΣ·ΔΕΚΑΤΗ<span style="display:block;font-size:0.65rem;margin-top:4px;letter-spacing:0;opacity:0.7"><a href="https://www.codexsinaiticus.org/en/manuscript.aspx?book=33&chapter=1&verse=39" target="_blank" style="color:#5d4037">Ver en Codex Sinaiticus →</a></span></div><div style="display:flex;gap:0.3rem;flex-wrap:wrap;margin-bottom:0.3rem;align-items:center"><div class="rvr-btn" onclick="toggleRVR(39)">RVR60</div><div class="rvr-btn" onclick="document.getElementById('uncial-39').style.display=document.getElementById('uncial-39').style.display==='none'?'':'none'" style="background:#efebe9;color:#5d4037;border-color:#bcaaa4" title="Escritura uncial: así se veía el NT en los manuscritos del s.IV (Vaticanus, Sinaiticus). Todo mayúsculas, sin espacios entre palabras (scriptio continua), sin acentos ni puntuación. La iota subscrita se escribe explícitamente.">Uncial</div><div class="rvr-btn" onclick="document.getElementById('pron-39').style.display=document.getElementById('pron-39').style.display==='none'?'':'none'" style="background:#e3f2fd;color:#1565c0;border-color:#90caf9" title="Pronunciación bizantina aproximada (griego moderno/eclesiástico)">Pronunciación</div><div class="rvr-btn vbtn-patr" onclick="toggleSection('patr-39')" title="8 citas patrísticas disponibles">✝ 8 patrística</div><div class="rvr-btn vbtn-exeg" onclick="toggleSection('exeg-39')" title="3 comentarios exegéticos">📚 3 exégesis</div><div class="rvr-btn vbtn-ver" onclick="document.getElementById('vers-39').classList.toggle('collapsed')" title="9 versiones disponibles">📖 versiones</div><div class="rvr-btn" onclick="document.getElementById('xrefs-39').classList.toggle('collapsed')" title="3 referencias cruzadas">🔗 3 refs</div><div class="rvr-btn" onclick="copyVerse(39)" title="Copiar versículo al portapapeles" style="background:#f3e5f5;border-color:#ce93d8;color:#6a1b9a">📋</div><div class="rvr-btn" onclick="document.getElementById('notes-39').style.display=document.getElementById('notes-39').style.display==='none'?'':'none'" title="Notas personales" style="background:#fff8e1;border-color:#ffd54f;color:#f57f17">📝</div></div><div id="rvr-39" class="collapsed spanish-line" style="color:#c62828">Les dijo: Venid y ved. Fueron, y vieron donde moraba, y se quedaron con él aquel día; porque era como la hora décima.</div><div id="vers-39" class="collapsed" style="margin-bottom:0.5rem"><div class="ver-line"><span class="ver-label">RVR60</span>Les dijo: Venid y ved. Fueron, y vieron donde moraba, y se quedaron con él aquel día; porque era como la hora décima.</div><div class="ver-line"><span class="ver-label">RVR1909</span>Díceles: Venid y ved. Vinieron, y vieron donde moraba, y quedáronse con él aquel día: porque era como la hora de las diez.</div><div class="ver-line"><span class="ver-label">KJV</span>He saith unto them, Come and see. They came and saw where he dwelt, and abode with him that day: for it was about the tenth hour.</div><div class="ver-line"><span class="ver-label">ASV</span>He saith unto them, Come, and ye shall see. They came therefore and saw where he abode; and they abode with him that day: it was about the tenth hour. </div><div class="ver-line"><span class="ver-label">BSB</span>“Come and see,” He replied. So they went and saw where He was staying, and spent that day with Him. It was about the tenth hour. </div><div class="ver-line"><span class="ver-label">Darby</span>He says to them, Come and see. They went therefore, and saw where he abode; and they abode with him that day. It was about the tenth hour. </div><div class="ver-line"><span class="ver-label">LITV</span>He said to them, Come and see. They went and saw where He stayed, and they remained with Him that day. And the hour was about the tenth. </div><div class="ver-line"><span class="ver-label">YLT</span>He saith to them, `Come and see;' they came, and saw where he doth remain, and with him they remained that day and the hour was about the tenth.</div><div class="ver-line"><span class="ver-label">Vulgate</span>dicit eis venite et videte venerunt et viderunt ubi maneret et apud eum manserunt die illo hora autem erat quasi decima</div></div><div id="xrefs-39" class="collapsed xref-container" style="margin-bottom:0.5rem"><span class="xref-pill" onclick="showXrefPopup(this)" data-ref="Luke 24:29" data-es="Mas ellos le detuvieron por fuerza, diciendo: Quédate con nosotros, porque se hace tarde, y el día ya ha declinado. Entró pues á estarse con ellos." data-gr="καὶ παρεβιάσαντο αὐτὸν λέγοντες· Μεῖνον μεθ’ ἡμῶν, ὅτι πρὸς ἑσπέραν ἐστὶν καὶ κέκλικεν ⸀ἤδη ἡ ἡμέρα. καὶ εἰσῆλθεν τοῦ μεῖναι σὺν αὐτοῖς." data-lxx="" title="Mas ellos le detuvieron por fuerza, diciendo: Quédate con nosotros, porque se ha…">Luke 24:29</span><span class="xref-pill" onclick="showXrefPopup(this)" data-ref="Matthew 11:28" data-es="Venid á mí todos los que estáis trabajados y cargados, que yo os haré descansar." data-gr="Δεῦτε πρός με πάντες οἱ κοπιῶντες καὶ πεφορτισμένοι, κἀγὼ ἀναπαύσω ὑμᾶς." data-lxx="" title="Venid á mí todos los que estáis trabajados y cargados, que yo os haré descansar.">Matthew 11:28</span><span class="xref-pill" onclick="showXrefPopup(this)" data-ref="Matthew 11:30" data-es="Porque mi yugo es fácil, y ligera mi carga." data-gr="ὁ γὰρ ζυγός μου χρηστὸς καὶ τὸ φορτίον μου ἐλαφρόν ἐστιν." data-lxx="" title="Porque mi yugo es fácil, y ligera mi carga.">Matthew 11:30</span></div><div id="pron-39" style="display:none;font-size:0.85rem;color:#1565c0;background:#e3f2fd;padding:4px 8px;border-radius:4px;margin-bottom:0.3rem;font-style:italic" class="pron-line"></div><div id="notes-39" style="display:none;margin-bottom:0.5rem"><textarea id="note-input-39" style="width:100%;min-height:50px;border:1px solid #ccc;border-radius:6px;padding:4px 8px;font-size:0.82rem;resize:vertical" placeholder="Tus notas para v.39..." oninput="saveNote(39)"></textarea></div><div class="section-toggle" onclick="toggleSection('exeg-39')" role="button" aria-expanded="false" aria-controls="exeg-39" tabindex="0"><span class="section-icon">📜</span> Exégesis del Griego <span class="arrow" id="arrow-exeg-39">▶</span></div><div id="exeg-39" class="collapsed section-content exeg-section" role="region"><div class="exeg-summary"><strong style="color:#1b5e20">Alford:</strong> Euthym [34] remarks, οὐκ ἀγνοῶν , ὁ τοῖς λογισμοῖς τῶν ἀνθρώπων ἐμβατεύων , ἀλλ ʼ ἵνα διὰ τῆς ἐρωτήσεως οἰκειώσηται τούτους , καὶ παράσχῃ θαῤῥεῖν.<br><strong style="color:#1b5e20">Bengel:</strong> Εἶδον , they saw ) They might have seen proofs of the Messiah in His dwelling; which was simple, quiet, neat, silent, and frugal, without any costly array of vases and books, (comp.<br><strong style="color:#1b5e20">Robertson:</strong> Come and ye shall see ( ερχεσθε κα οψεσθε ).<br></div><div class="comm-item"><div class="comm-header" onclick="document.getElementById('uexv39_0').classList.toggle('collapsed')"><strong>Alford's Greek Testament</strong> <span style=color:#888;font-size:0.75rem>(1863)</span><span class="small-arrow">ver completo ▼</span></div><div id="uexv39_0" class="collapsed comm-body">39. ] On τί ζητ . Euthym [34] remarks, οὐκ ἀγνοῶν , ὁ τοῖς λογισμοῖς τῶν ἀνθρώπων ἐμβατεύων , ἀλλ ʼ ἵνα διὰ τῆς ἐρωτήσεως οἰκειώσηται τούτους , καὶ παράσχῃ θαῤῥεῖν . εἰκὸς γὰρ αὐτοὺς ἐρυθριᾶν ἔτι καὶ ἀγωνιᾶν , ὡς ἀγνῶτας . [34] Euthymius Zigabenus, 1116</div></div><div class="comm-item"><div class="comm-header" onclick="document.getElementById('uexv39_1').classList.toggle('collapsed')"><strong>Bengel's Gnomon</strong> <span style=color:#888;font-size:0.75rem>(1742)</span><span class="small-arrow">ver completo ▼</span></div><div id="uexv39_1" class="collapsed comm-body">[John 1:39] . Εἶδον , they saw ) They might have seen proofs of the Messiah in His dwelling; which was simple, quiet, neat, silent, and frugal, without any costly array of vases and books, (comp. [2 Kings 4:10] [Elisha&rsquo;s &ldquo;little chamber on the wall&rdquo; of the Shunammite, containing &ldquo;a bed, table, stool, and candlestick,&rdquo;]) in a word, worthy of Himself and of Him alone. ἔμειναν , they abode ) Constancy becomes disciples. ἡμέραν , day ) O happy day! ὥρα , hour ) Andrew made haste, even though late in the evening, to tell the [glad] tidings to his brother.[ These incidents preceded sunset by two hours , V. g.]</div></div><div class="comm-item"><div class="comm-header" onclick="document.getElementById('uexv39_2').classList.toggle('collapsed')"><strong>Robertson's Word Pictures</strong> <span style=color:#888;font-size:0.75rem>(1933)</span><span class="small-arrow">ver completo ▼</span></div><div id="uexv39_2" class="collapsed comm-body">Come and ye shall see ( ερχεσθε κα οψεσθε ). Polite invitation and definite promise (future middle indicative οψεσθε from οραω , correct text, not imperative ιδετε ). Where he abode ( που μενε ). Indirect question preserving the present active indicative after secondary tense ( ειδαν , saw) according to regular Greek idiom. Same verb μενω as in [John 1:38]. With him ( παρ' αυτω ). "By his side," "beside him." That day ( την ημεραν εκεινην ). Accusative of extent of time, all during that day. About the tenth hour ( ωρα ως δεκατη ). Roman time and so ten o'clock in the morning. John in Ephesus at the close of the century naturally uses Roman time. See [John 20:19] "evening on that day," clearly Roman time. Thus also [John 19:14] (sixth hour, morning) and [Mark 15:25] (third hour, nine A.M.) suit. To his latest day John never forgot the hour when first he met Jesus.</div></div><div class="themes-divider">🔍 Temas discutidos</div><div class="theme-card"><div class="theme-word">ὥρα ὡς δεκάτη</div><div class="consensus-bar"><div style="width:25%;background:#f44336"></div></div><div class="opinion" style="border-left-color:#f44336">❌ <strong>Alford</strong> La hora décima es 4 P.M. según el cómputo judío, no 10 A.M. según el romano, ya que Juan siempre usa el método judío</div><div class="opinion" style="border-left-color:#4caf50">✅ <strong>Bengel</strong> Era tarde en la tarde, pero Andrés se apresuró a contar las buenas nuevas a su hermano a pesar de la hora tardía</div><div class="opinion" style="border-left-color:#f44336">❌ <strong>Robertson</strong> Tiempo romano, las diez de la mañana, ya que Juan en Éfeso naturalmente usa el tiempo romano al final del siglo</div><div class="theme-summary">Hay desacuerdo fundamental sobre si Juan usa el sistema horario judío (4 P.M.) o romano (10 A.M.).</div></div></div><div class="section-toggle" onclick="toggleSection('patr-39')" role="button" aria-expanded="false" aria-controls="patr-39" tabindex="0"><span class="section-icon">👨‍🏫</span> Patrística · 2 temas · 8 citas <span class="arrow" id="arrow-patr-39">▶</span></div><div id="patr-39" class="collapsed section-content patr-section" role="region"><div class="patr-theme"><div class="patr-theme-header" onclick="document.getElementById('pt1dccd02a').classList.toggle('collapsed');this.querySelector('.arrow').classList.toggle('open')"><strong>El significado de la décima hora</strong><div class="consensus-bar" style="width:60px"><div style="width:55%;background:#ff9800"></div></div><span class="consensus-label" style="color:#ff9800">medio</span><span class="arrow">▼</span></div><div id="pt1dccd02a" class="collapsed" style="padding:0.5rem 0.2rem 0"><div class="patr-citation" style="border-left-color:#4caf50"><div class="patr-cite-header">✅ <strong>Augustine of Hippo</strong> (s.IV-V (354-430)) <span class="patr-meta">— Obispo de Hipona, Doctor de la Iglesia, discípulo de Ambrosio de Milán (Hipona)</span> <a href="https://es.wikipedia.org/wiki/Agust%C3%ADn_de_Hipona" target="_blank" class="patr-link">📖</a> <span class="patr-verse-ref">[v.38]</span></div><div class="patr-cite-text">"Do we think that it did in no wise pertain to the evangelist to tell us what hour it was? Is it possible that he wished us to give heed to nothing in that, to inquire after nothing? It was the tenth hour. That number signifies the law, because the law was given in ten commandments."</div></div><div class="patr-citation" style="border-left-color:#4caf50"><div class="patr-cite-header">✅ <strong>Augustine of Hippo</strong> (s.IV-V (354-430)) <span class="patr-meta">— Obispo de Hipona, Doctor de la Iglesia, discípulo de Ambrosio de Milán (Hipona)</span> <a href="https://es.wikipedia.org/wiki/Agust%C3%ADn_de_Hipona" target="_blank" class="patr-link">📖</a> <span class="patr-verse-ref">[v.39]</span></div><div class="patr-cite-text">"The number here signifies the law, which was composed of ten commandments. The time had come when the law was to be fulfilled by love, the Jews, who acted from fear, having been unable to fulfil it, and therefore was it at the tenth hour that our Lord heard Himself called, Rabbi"</div></div><div class="patr-resumen">Agustín propone una interpretación simbólica de la décima hora como referencia a los diez mandamientos y el cumplimiento de la ley por el amor. Otros Padres no desarrollan esta interpretación específica.</div></div></div><div class="patr-theme"><div class="patr-theme-header" onclick="document.getElementById('pt63267e6f').classList.toggle('collapsed');this.querySelector('.arrow').classList.toggle('open')"><strong>La invitación "Venid y ved"</strong><div class="consensus-bar" style="width:60px"><div style="width:85%;background:#4caf50"></div></div><span class="consensus-label" style="color:#4caf50">alto</span><span class="arrow">▼</span></div><div id="pt63267e6f" class="collapsed" style="padding:0.5rem 0.2rem 0"><div class="patr-citation" style="border-left-color:#4caf50"><div class="patr-cite-header">✅ <strong>Cyril of Alexandria</strong> (s.V (c.376-444)) <span class="patr-meta">— Patriarca de Alejandría, Concilio de Éfeso (Alejandría)</span> <a href="https://es.wikipedia.org/wiki/Cirilo_de_Alejandr%C3%ADa" target="_blank" class="patr-link">📖</a> <span class="patr-verse-ref">[v.39]</span></div><div class="patr-cite-text">"He doth not point out the house, though asked to do it, but rather bids them come forthwith to it: teaching first, as by example, that it is not well to cast delays in the way of search after what is good (for delay in things profitable is altogether hurtful): and this too besides, that to those who are still ignorant of the holy house of our Saviour Christ, that is, the Church, it will not suffice to salvation that they should learn where it is, but that they"</div></div><div class="patr-citation" style="border-left-color:#4caf50"><div class="patr-cite-header">✅ <strong>John Chrysostom</strong> (s.IV (c.349-407)) <span class="patr-meta">— Patriarca de Constantinopla, "Boca de Oro", discípulo de Diodoro de Tarso (Antioquía/Constantinopla)</span> <a href="https://es.wikipedia.org/wiki/Juan_Cris%C3%B3stomo" target="_blank" class="patr-link">📖</a> <span class="patr-verse-ref">[v.39]</span></div><div class="patr-cite-text">"And therefore Christ does not tell them the marks of His abode, nor its situation, but rather induces them to follow Him by showing them that He had accepted them. For this reason He did not say anything of this kind to them, "It is an unseasonable time now for you to enter into the house, to-morrow you shall hear if you have any wish, return home now"; but converses with them as with friends, and those who had long been with Him."</div></div><div class="patr-citation" style="border-left-color:#ff9800"><div class="patr-cite-header">⚠️ <strong>Origen of Alexandria</strong> (s.III (c.185-254)) <span class="patr-meta">— Maestro catequético, exégeta, discípulo de Clemente de Alejandría (Alejandría/Cesarea)</span> <a href="https://es.wikipedia.org/wiki/Or%C3%ADgenes" target="_blank" class="patr-link">📖</a> <span class="patr-verse-ref">[v.39]</span></div><div class="patr-cite-text">"Or perhaps come, is an invitation to action; see, to contemplation."</div></div><div class="patr-resumen">Los Padres ven en "Venid y ved" una invitación que enseña a no dilatar la búsqueda del bien y muestra la aceptación de Cristo hacia los discípulos. Orígenes añade una dimensión contemplativa.</div></div></div></div></div><div class="verse-block" id="vb40"><div class="verse-header"><span class="vnum">40</span></div><div class="greek-line" id="greek-40">Ἦν Ἀνδρέας ὁ ἀδελφὸς Σίμωνος Πέτρου εἷς ἐκ τῶν δύο τῶν ἀκουσάντων παρὰ Ἰωάννου καὶ ἀκολουθησάντων αὐτῷ</div><div class="uncial-line" id="uncial-40" style="display:none;font-family:'Noto Serif',serif;font-size:0.9rem;letter-spacing:1.5px;color:#5d4037;background:#efebe9;padding:6px 10px;border-radius:4px;margin-bottom:0.3rem;overflow-wrap:break-word" title="Así se vería este versículo en un manuscrito uncial del siglo IV — todo mayúsculas, sin espacios (puntos medios añadidos como ayuda visual)">ΗΝ·ΑΝΔΡΕΑΣ·Ο·ΑΔΕΛΦΟΣ·ΣΙΜΩΝΟΣ·ΠΕΤΡΟΥ·ΕΙΣ·ΕΚ·ΤΩΝ·ΔΥΟ·ΤΩΝ·ΑΚΟΥΣΑΝΤΩΝ·ΠΑΡΑ·ΙΩΑΝΝΟΥ·ΚΑΙ·ΑΚΟΛΟΥΘΗΣΑΝΤΩΝ·ΑΥΤΩΙ<span style="display:block;font-size:0.65rem;margin-top:4px;letter-spacing:0;opacity:0.7"><a href="https://www.codexsinaiticus.org/en/manuscript.aspx?book=33&chapter=1&verse=40" target="_blank" style="color:#5d4037">Ver en Codex Sinaiticus →</a></span></div><div style="display:flex;gap:0.3rem;flex-wrap:wrap;margin-bottom:0.3rem;align-items:center"><div class="rvr-btn" onclick="toggleRVR(40)">RVR60</div><div class="rvr-btn" onclick="document.getElementById('uncial-40').style.display=document.getElementById('uncial-40').style.display==='none'?'':'none'" style="background:#efebe9;color:#5d4037;border-color:#bcaaa4" title="Escritura uncial: así se veía el NT en los manuscritos del s.IV (Vaticanus, Sinaiticus). Todo mayúsculas, sin espacios entre palabras (scriptio continua), sin acentos ni puntuación. La iota subscrita se escribe explícitamente.">Uncial</div><div class="rvr-btn" onclick="document.getElementById('pron-40').style.display=document.getElementById('pron-40').style.display==='none'?'':'none'" style="background:#e3f2fd;color:#1565c0;border-color:#90caf9" title="Pronunciación bizantina aproximada (griego moderno/eclesiástico)">Pronunciación</div><div class="rvr-btn vbtn-patr" onclick="toggleSection('patr-40')" title="4 citas patrísticas disponibles">✝ 4 patrística</div><div class="rvr-btn vbtn-exeg" onclick="toggleSection('exeg-40')" title="2 comentarios exegéticos">📚 2 exégesis</div><div class="rvr-btn vbtn-ver" onclick="document.getElementById('vers-40').classList.toggle('collapsed')" title="9 versiones disponibles">📖 versiones</div><div class="rvr-btn" onclick="copyVerse(40)" title="Copiar versículo al portapapeles" style="background:#f3e5f5;border-color:#ce93d8;color:#6a1b9a">📋</div><div class="rvr-btn" onclick="document.getElementById('notes-40').style.display=document.getElementById('notes-40').style.display==='none'?'':'none'" title="Notas personales" style="background:#fff8e1;border-color:#ffd54f;color:#f57f17">📝</div></div><div id="rvr-40" class="collapsed spanish-line">Andrés, hermano de Simón Pedro, era uno de los dos que habían oído a Juan, y habían seguido a Jesús.</div><div id="vers-40" class="collapsed" style="margin-bottom:0.5rem"><div class="ver-line"><span class="ver-label">RVR60</span>Andrés, hermano de Simón Pedro, era uno de los dos que habían oído a Juan, y habían seguido a Jesús.</div><div class="ver-line"><span class="ver-label">RVR1909</span>Era Andrés, hermano de Simón Pedro, uno de los dos que habían oído de Juan, y le habían seguido.</div><div class="ver-line"><span class="ver-label">KJV</span>One of the two which heard John speak, and followed him, was Andrew, Simon Peter’s brother.</div><div class="ver-line"><span class="ver-label">ASV</span>One of the two that heard John speak, and followed him, was Andrew, Simon Peter’s brother. </div><div class="ver-line"><span class="ver-label">BSB</span>Andrew, Simon Peter’s brother, was one of the two who heard John’s testimony and followed Jesus. </div><div class="ver-line"><span class="ver-label">Darby</span>Andrew, the brother of Simon Peter, was one of the two who heard [this] from John and followed him. </div><div class="ver-line"><span class="ver-label">LITV</span>Andrew the brother of Simon Peter was one of the two who heard from John and was following Him. </div><div class="ver-line"><span class="ver-label">YLT</span>Andrew, the brother of Simon Peter, was one of the two who heard from John, and followed him;</div><div class="ver-line"><span class="ver-label">Vulgate</span>erat autem Andreas frater Simonis Petri unus ex duobus qui audierant ab Iohanne et secuti fuerant eum</div></div><div id="pron-40" style="display:none;font-size:0.85rem;color:#1565c0;background:#e3f2fd;padding:4px 8px;border-radius:4px;margin-bottom:0.3rem;font-style:italic" class="pron-line"></div><div id="notes-40" style="display:none;margin-bottom:0.5rem"><textarea id="note-input-40" style="width:100%;min-height:50px;border:1px solid #ccc;border-radius:6px;padding:4px 8px;font-size:0.82rem;resize:vertical" placeholder="Tus notas para v.40..." oninput="saveNote(40)"></textarea></div><div class="section-toggle" onclick="toggleSection('exeg-40')" role="button" aria-expanded="false" aria-controls="exeg-40" tabindex="0"><span class="section-icon">📜</span> Exégesis del Griego <span class="arrow" id="arrow-exeg-40">▶</span></div><div id="exeg-40" class="collapsed section-content exeg-section" role="region"><div class="exeg-summary"><strong style="color:#1b5e20">Alford:</strong> , βουλόμενοι καταμόνας ἐντυχεῖν αὐτῷ καὶ μεθ ʼ ἡσυχίας.<br><strong style="color:#1b5e20">Robertson:</strong> "That heard from John," a classical idiom ( παρα with ablative after ακουω ) seen also in [John 6:45]; [John 7:51]; [John 8:26]; [John 8:40]; [John 15:15].<br></div><div class="comm-item"><div class="comm-header" onclick="document.getElementById('uexv40_0').classList.toggle('collapsed')"><strong>Alford's Greek Testament</strong> <span style=color:#888;font-size:0.75rem>(1863)</span><span class="small-arrow">ver completo ▼</span></div><div id="uexv40_0" class="collapsed comm-body">40. ] They ask ποῦ μ ., βουλόμενοι καταμόνας ἐντυχεῖν αὐτῷ καὶ μεθ ʼ ἡσυχίας . Euthym [35] They enquire after His place of lodging for the night , intending to visit Him there; or perhaps He was then apparently going thither, as it was late in the day. But He furthers their wish by inviting them to follow, and they will see. [35] Euthymius Zigabenus, 1116 ὡς δεκάτη ] i.e. 4 P.M., according to the Jewish reckoning; not, as some have thought, 10 A.M., according to that of the Romans. Our Evangelist appears always to reckon according to the Jewish method, see ch. [John 4:6] ; [John 4:52] ; [John 19:14] , and notes, but especially ch. [John 11:9] . And as Lücke remarks (i. 446), even among the Romans, the division of the day into twelve equal hours was, though not the civil , the popular way of computing time. So Persius, Sat. iii. 3: &ldquo;Stertimus … quinta dum linea tangitur umbra.&rdquo; They remained with Him the rest of that day , which would be four or five hours, and need not strictly be limited by sunset.</div></div><div class="comm-item"><div class="comm-header" onclick="document.getElementById('uexv40_1').classList.toggle('collapsed')"><strong>Robertson's Word Pictures</strong> <span style=color:#888;font-size:0.75rem>(1933)</span><span class="small-arrow">ver completo ▼</span></div><div id="uexv40_1" class="collapsed comm-body">Andrew ( Ανδρεας ). Explained by John as one of the two disciples of the Baptist and identified as the brother of the famous Simon Peter (cf. also [John 6:8]; [John 12:22]). The more formal call of Andrew and Simon, James and John, comes later ([Mark 1:16]; [Matthew 4:18]; [Luke 3:1-11]). That heard John speak ( των ακουσαντων παρα Ιωανου ). "That heard from John," a classical idiom ( παρα with ablative after ακουω ) seen also in [John 6:45]; [John 7:51]; [John 8:26]; [John 8:40]; [John 15:15].</div></div></div><div class="section-toggle" onclick="toggleSection('patr-40')" role="button" aria-expanded="false" aria-controls="patr-40" tabindex="0"><span class="section-icon">👨‍🏫</span> Patrística (4 citas) <span class="arrow" id="arrow-patr-40">▶</span></div><div id="patr-40" class="collapsed section-content patr-section" role="region"><div class="patr-citation" style="border-left-color:#9e9e9e"><div class="patr-cite-header"><strong>Gospel of Peter</strong> <em>(Section V.)</em></div><div class="patr-cite-text">Or, speaking.
275:He is described, thirdly, by his discipleship, because he was one of the two who had followed him. His name is mentioned in order to show that Andrew's privilege was remarkable. For the name of the other disciple is not mentioned: either because it was John the Evangelist himself, who through humility followed the practice in his Gospel of not mentioning his own name when he was involved in some event; or, according to Chrysostom, because the other one was not a notable person, nor had he done anything great, and so there was no need to mention his name. Luke does the same in his Gospel (10:1), where he does not mention the names of the seventy-two disciples sent out by the Lord</div></div></div></div><div class="verse-block" id="vb41"><div class="verse-header"><span class="vnum">41</span></div><div class="greek-line" id="greek-41">εὑρίσκει οὗτος πρῶτον τὸν ἀδελφὸν τὸν ἴδιον Σίμωνα καὶ λέγει αὐτῷ Εὑρήκαμεν τὸν Μεσσίαν ὅ ἐστιν μεθερμηνευόμενον Χριστός</div><div class="uncial-line" id="uncial-41" style="display:none;font-family:'Noto Serif',serif;font-size:0.9rem;letter-spacing:1.5px;color:#5d4037;background:#efebe9;padding:6px 10px;border-radius:4px;margin-bottom:0.3rem;overflow-wrap:break-word" title="Así se vería este versículo en un manuscrito uncial del siglo IV — todo mayúsculas, sin espacios (puntos medios añadidos como ayuda visual)">ΕΥΡΙΣΚΕΙ·ΟΥΤΟΣ·ΠΡΩΤΟΝ·ΤΟΝ·ΑΔΕΛΦΟΝ·ΤΟΝ·ΙΔΙΟΝ·ΣΙΜΩΝΑ·ΚΑΙ·ΛΕΓΕΙ·ΑΥΤΩΙ·ΕΥΡΗΚΑΜΕΝ·ΤΟΝ·ΜΕΣΣΙΑΝ·Ο·ΕΣΤΙΝ·ΜΕΘΕΡΜΗΝΕΥΟΜΕΝΟΝ·ΧΡΙΣΤΟΣ<span style="display:block;font-size:0.65rem;margin-top:4px;letter-spacing:0;opacity:0.7"><a href="https://www.codexsinaiticus.org/en/manuscript.aspx?book=33&chapter=1&verse=41" target="_blank" style="color:#5d4037">Ver en Codex Sinaiticus →</a></span></div><div style="display:flex;gap:0.3rem;flex-wrap:wrap;margin-bottom:0.3rem;align-items:center"><div class="rvr-btn" onclick="toggleRVR(41)">RVR60</div><div class="rvr-btn" onclick="document.getElementById('uncial-41').style.display=document.getElementById('uncial-41').style.display==='none'?'':'none'" style="background:#efebe9;color:#5d4037;border-color:#bcaaa4" title="Escritura uncial: así se veía el NT en los manuscritos del s.IV (Vaticanus, Sinaiticus). Todo mayúsculas, sin espacios entre palabras (scriptio continua), sin acentos ni puntuación. La iota subscrita se escribe explícitamente.">Uncial</div><div class="rvr-btn" onclick="document.getElementById('pron-41').style.display=document.getElementById('pron-41').style.display==='none'?'':'none'" style="background:#e3f2fd;color:#1565c0;border-color:#90caf9" title="Pronunciación bizantina aproximada (griego moderno/eclesiástico)">Pronunciación</div><div class="rvr-btn vbtn-patr" onclick="toggleSection('patr-41')" title="10 citas patrísticas disponibles">✝ 10 patrística</div><div class="rvr-btn vbtn-exeg" onclick="toggleSection('exeg-41')" title="3 comentarios exegéticos">📚 3 exégesis</div><div class="rvr-btn vbtn-ver" onclick="document.getElementById('vers-41').classList.toggle('collapsed')" title="9 versiones disponibles">📖 versiones</div><div class="rvr-btn" onclick="copyVerse(41)" title="Copiar versículo al portapapeles" style="background:#f3e5f5;border-color:#ce93d8;color:#6a1b9a">📋</div><div class="rvr-btn" onclick="document.getElementById('notes-41').style.display=document.getElementById('notes-41').style.display==='none'?'':'none'" title="Notas personales" style="background:#fff8e1;border-color:#ffd54f;color:#f57f17">📝</div></div><div id="rvr-41" class="collapsed spanish-line">Este halló primero a su hermano Simón, y le dijo: Hemos hallado al Mesías (que traducido es, el Cristo).</div><div id="vers-41" class="collapsed" style="margin-bottom:0.5rem"><div class="ver-line"><span class="ver-label">RVR60</span>Este halló primero a su hermano Simón, y le dijo: Hemos hallado al Mesías (que traducido es, el Cristo).</div><div class="ver-line"><span class="ver-label">RVR1909</span>Este halló primero á su hermano Simón, y díjole: Hemos hallado al Mesías (que declarado es, el Cristo).</div><div class="ver-line"><span class="ver-label">KJV</span>He first findeth his own brother Simon, and saith unto him, We have found the Messias, which is, being interpreted, the Christ.</div><div class="ver-line"><span class="ver-label">ASV</span>He findeth first his own brother Simon, and saith unto him, We have found the Messiah (which is, being interpreted, Christ). </div><div class="ver-line"><span class="ver-label">BSB</span>He first found his brother Simon and told him, “We have found the Messiah” (which is translated as Christ). </div><div class="ver-line"><span class="ver-label">Darby</span>He first finds his own brother Simon, and says to him, We have found the Messias (which being interpreted is Christ). </div><div class="ver-line"><span class="ver-label">LITV</span>This one first found his own brother Simon and tells him, We have found the Messiah (which being translated is, the Christ). </div><div class="ver-line"><span class="ver-label">YLT</span>this one doth first find his own brother Simon, and saith to him, `We have found the Messiah,' (which is, being interpreted, The Anointed,)</div><div class="ver-line"><span class="ver-label">Vulgate</span>invenit hic primum fratrem suum Simonem et dicit ei invenimus Messiam quod est interpretatum Christus</div></div><div id="pron-41" style="display:none;font-size:0.85rem;color:#1565c0;background:#e3f2fd;padding:4px 8px;border-radius:4px;margin-bottom:0.3rem;font-style:italic" class="pron-line"></div><div id="notes-41" style="display:none;margin-bottom:0.5rem"><textarea id="note-input-41" style="width:100%;min-height:50px;border:1px solid #ccc;border-radius:6px;padding:4px 8px;font-size:0.82rem;resize:vertical" placeholder="Tus notas para v.41..." oninput="saveNote(41)"></textarea></div><div class="section-toggle" onclick="toggleSection('exeg-41')" role="button" aria-expanded="false" aria-controls="exeg-41" tabindex="0"><span class="section-icon">📜</span> Exégesis del Griego <span class="arrow" id="arrow-exeg-41">▶</span></div><div id="exeg-41" class="collapsed section-content exeg-section" role="region"><div class="exeg-summary"><strong style="color:#1b5e20">Alford:</strong> Euthymius gives an alternative which is hardly probable: ἢ διότι οὐκ ἦν τῶν ἐπισήμων καὶ γνωρίμων ἐκεῖνος , ἢ ὅτι αὐτὸς ἦν ὁ ταῦτα γράφων.<br><strong style="color:#1b5e20">Bengel:</strong> Εὑρίσκει , findeth ) With the festival-like [joyous] freshness of those days beautifully corresponds the word findeth , which is used here more frequently [than elsewhere].<br><strong style="color:#1b5e20">Robertson:</strong> But Aleph L W read πρωτος (nominative adjective) which means that Andrew was the first who went after his brother implying that John also went after his brother James.<br></div><div class="comm-item"><div class="comm-header" onclick="document.getElementById('uexv41_0').classList.toggle('collapsed')"><strong>Alford's Greek Testament</strong> <span style=color:#888;font-size:0.75rem>(1863)</span><span class="small-arrow">ver completo ▼</span></div><div id="uexv41_0" class="collapsed comm-body">41. ] Who the other disciple was, is not certain: but considering (1) that the Evangelist never names himself in his Gospel, and (2) that this account is so minutely accurate as to specify even the hours of the day, and in all respects bears marks of an eye-witness , and again (3) that this other disciple, from this last circumstance, certainly would have been named , had not the name been suppressed for some especial reason , we are justified in inferring that it was the Evangelist himself . And such has been the general opinion. Euthymius gives an alternative which is hardly probable: ἢ διότι οὐκ ἦν τῶν ἐπισήμων καὶ γνωρίμων ἐκεῖνος , ἢ ὅτι αὐτὸς ἦν ὁ ταῦτα γράφων .</div></div><div class="comm-item"><div class="comm-header" onclick="document.getElementById('uexv41_1').classList.toggle('collapsed')"><strong>Bengel's Gnomon</strong> <span style=color:#888;font-size:0.75rem>(1742)</span><span class="small-arrow">ver completo ▼</span></div><div id="uexv41_1" class="collapsed comm-body">[John 1:41] . Εὑρίσκει , findeth ) With the festival-like [joyous] freshness of those days beautifully corresponds the word findeth , which is used here more frequently [than elsewhere]. πρῶτος , first ) It is to be presumed, that both of them sought Simon by different roads. [40] τὸν ἀδελφὸν , his brother ) He afterwards became superior to Andrew, who, it is probable, was the elder born; [John 1:44] [the order there is, &ldquo;Andrew and Peter&rdquo;]. εὑρήκαμεν , we have found) [John 1:45] , &ldquo;We have found Him, of whom Moses in the law and the prophets did write&rdquo; [Philip to Nathanael]. A great and joyful εὓρημα , treasure-found , expected by the world for about forty centuries. They had learned from John, that He was close at hand. ὅ , which ) This is an addition of the Evangelist, as at [John 1:42] . [40] Rather, as Andrew first of the two disciples found his own brother and brought him to Jesus; so the other disciple, who was probably John, did the same, and brought his brother, James, to the Saviour. E. and T.</div></div><div class="comm-item"><div class="comm-header" onclick="document.getElementById('uexv41_2').classList.toggle('collapsed')"><strong>Robertson's Word Pictures</strong> <span style=color:#888;font-size:0.75rem>(1933)</span><span class="small-arrow">ver completo ▼</span></div><div id="uexv41_2" class="collapsed comm-body">He findeth first ( ευρισκε ουτος πρωτον ). "This one finds (vivid dramatic present) first" ( προτων ). Προτων (adverb supported by Aleph A B fam. 13) means that Andrew sought "his own brother Simon" ( τον αδελφον τον ιδιον Σιμωνα ) before he did anything else. But Aleph L W read πρωτος (nominative adjective) which means that Andrew was the first who went after his brother implying that John also went after his brother James. Some old Latin manuscripts (b, e, r apparently), have μανε for Greek πρω (early in the morning). Bernard thinks that this is the true reading as it allows more time for Andrew to bring Simon to Jesus. Probably πρωτον is correct, but even so John likely brought also his brother James after Andrew's example. We have found the Messiah ( Hευρηκαμεν τον Μεσσιαν ). First aorist active indicative of ευρισκω . Andrew and John had made the greatest discovery of the ages, far beyond gold or diamond mines. The Baptist had told about him. "We have seen him." Which is ( ο εστιν ). Same explanatory neuter relative as in verse [John 1:38], "which word is." This Aramaic title Messiah is preserved in the N.T. only here and [John 4:25], elsewhere translated into Χριστος , Anointed One, from χριω , to anoint. See on [Matthew 1:1] for discussion.</div></div><div class="themes-divider">🔍 Temas discutidos</div><div class="theme-card"><div class="theme-word">πρῶτον/πρῶτος</div><div class="consensus-bar"><div style="width:55%;background:#ff9800"></div></div><div class="opinion" style="border-left-color:#4caf50">✅ <strong>Robertson</strong> Prefiere πρῶτον (adverbio) significando que Andrés buscó a su hermano antes que nada, aunque reconoce la variante πρῶτος que implicaría que Juan también buscó a Santiago</div><div class="opinion" style="border-left-color:#ff9800">⚠️ <strong>Bengel</strong> Interpreta πρῶτος sugiriendo que ambos discípulos buscaron a sus hermanos por caminos diferentes</div><div class="theme-summary">Hay debate textual entre πρῶτον (adverbio) y πρῶτος (adjetivo) con diferentes implicaciones sobre si ambos discípulos buscaron hermanos simultáneamente.</div></div></div><div class="section-toggle" onclick="toggleSection('patr-41')" role="button" aria-expanded="false" aria-controls="patr-41" tabindex="0"><span class="section-icon">👨‍🏫</span> Patrística · 2 temas · 10 citas <span class="arrow" id="arrow-patr-41">▶</span></div><div id="patr-41" class="collapsed section-content patr-section" role="region"><div class="patr-theme"><div class="patr-theme-header" onclick="document.getElementById('ptc62b47e3').classList.toggle('collapsed');this.querySelector('.arrow').classList.toggle('open')"><strong>Andrés como primer evangelizador</strong><div class="consensus-bar" style="width:60px"><div style="width:85%;background:#4caf50"></div></div><span class="consensus-label" style="color:#4caf50">alto</span><span class="arrow">▼</span></div><div id="ptc62b47e3" class="collapsed" style="padding:0.5rem 0.2rem 0"><div class="patr-citation" style="border-left-color:#4caf50"><div class="patr-cite-header">✅ <strong>John Chrysostom</strong> (s.IV (c.349-407)) <span class="patr-meta">— Patriarca de Constantinopla, "Boca de Oro", discípulo de Diodoro de Tarso (Antioquía/Constantinopla)</span> <a href="https://es.wikipedia.org/wiki/Juan_Cris%C3%B3stomo" target="_blank" class="patr-link">📖</a> <span class="patr-verse-ref">[v.41]</span></div><div class="patr-cite-text">"Andrew, after having tarried with Jesus and learned what He did, kept not the treasure to himself, but hastens and runs quickly to his brother, to impart to him of the good things which he had received. Observe what Andrew says to his brother; "We have found the Messias, which is, being interpreted, the Christ.""</div></div><div class="patr-citation" style="border-left-color:#4caf50"><div class="patr-cite-header">✅ <strong>Cyril of Alexandria</strong> (s.V (c.376-444)) <span class="patr-meta">— Patriarca de Alejandría, Concilio de Éfeso (Alejandría)</span> <a href="https://es.wikipedia.org/wiki/Cirilo_de_Alejandr%C3%ADa" target="_blank" class="patr-link">📖</a> <span class="patr-verse-ref">[v.41]</span></div><div class="patr-cite-text">"They who even now received the talent, straightway make traffic of their talent, and bring it to the Lord. For such are in truth obedient and docile souls, not needing many words for profit, nor bearing the fruit of their instruction, after revolutions of years or months, but attaining the goal of wisdom along with the commencement of their instruction."</div></div><div class="patr-citation" style="border-left-color:#4caf50"><div class="patr-cite-header">✅ <strong>Thomas Aquinas</strong> (s.XIII (1225-1274)) <span class="patr-meta">— Teólogo escolástico, Doctor de la Iglesia, discípulo de Alberto Magno (Italia)</span> <a href="https://es.wikipedia.org/wiki/Tom%C3%A1s_de_Aquino" target="_blank" class="patr-link">📖</a> <span class="patr-verse-ref">[v.41]</span></div><div class="patr-cite-text">"The evident sign of a perfect conversion of anyone is that, once converted, the closer one is to him the more he tries to convert him to Christ. And so Andrew, being now perfectly converted, does not keep the treasure"</div></div><div class="patr-resumen">Los Padres alaban a Andrés como modelo del convertido perfecto que inmediatamente comparte el tesoro encontrado con sus seres más cercanos. Su evangelización de Pedro muestra la naturaleza expansiva del encuentro con Cristo.</div></div></div><div class="patr-theme"><div class="patr-theme-header" onclick="document.getElementById('pt9294ece1').classList.toggle('collapsed');this.querySelector('.arrow').classList.toggle('open')"><strong>El significado del título Mesías/Cristo</strong><div class="consensus-bar" style="width:60px"><div style="width:85%;background:#4caf50"></div></div><span class="consensus-label" style="color:#4caf50">alto</span><span class="arrow">▼</span></div><div id="pt9294ece1" class="collapsed" style="padding:0.5rem 0.2rem 0"><div class="patr-citation" style="border-left-color:#4caf50"><div class="patr-cite-header">✅ <strong>Augustine of Hippo</strong> (s.IV-V (354-430)) <span class="patr-meta">— Obispo de Hipona, Doctor de la Iglesia, discípulo de Ambrosio de Milán (Hipona)</span> <a href="https://es.wikipedia.org/wiki/Agust%C3%ADn_de_Hipona" target="_blank" class="patr-link">📖</a> <span class="patr-verse-ref">[v.41]</span></div><div class="patr-cite-text">"Messias, in Hebrew; Christ, in Greek; in Latin, Anointed. Chrisma is anointing in Greek; Christ, therefore, is the Anointed. He is peculiarly anointed, pre-eminently anointed; wherewith all Christians are"</div></div><div class="patr-citation" style="border-left-color:#4caf50"><div class="patr-cite-header">✅ <strong>Augustine of Hippo</strong> (s.IV-V (354-430)) <span class="patr-meta">— Obispo de Hipona, Doctor de la Iglesia, discípulo de Ambrosio de Milán (Hipona)</span> <a href="https://es.wikipedia.org/wiki/Agust%C3%ADn_de_Hipona" target="_blank" class="patr-link">📖</a> <span class="patr-verse-ref">[v.41]</span></div><div class="patr-cite-text">"Messias in Hebrew, Christus in Greek, Unctus in Latin. Chrism is unction, and He had a special unction, which from Him extended to all Christians, as appears in the Psalm, God, even Thy God, hath anointed Thee with the oil of gladness above Thy fellows."</div></div><div class="patr-resumen">Los Padres explican la equivalencia lingüística entre Mesías (hebreo) y Cristo (griego), ambos significando "Ungido". Enfatizan que Cristo tiene una unción especial y preeminente que se extiende a todos los cristianos.</div></div></div></div><div class="section-toggle" onclick="toggleSection('tc-41')" role="button" aria-expanded="false" aria-controls="tc-41" tabindex="0"><span class="section-icon">⚖️</span> Crítica Textual <span style="font-size:0.7rem;color:#ff9800">(4 lecturas)</span> <span class="arrow" id="arrow-tc-41">▶</span></div><div id="tc-41" class="collapsed section-content tc-section"><div class="tc-verdict" style="margin-bottom:0.8rem"><div class="tc-verdict-text"><strong>Veredicto:</strong> La lectura #11.1 (πρῶτον) es probablemente original, apoyada por manuscritos tempranos como P66, P75, א2, A, B. La lectura #11.2 (πρῶτος) cambia el adverbio por un adjetivo, posiblemente para concordar con un sustantivo implícito. La lectura #11.3 (πρωΐ) cambia completamente el sentido de 'primero' a 'temprano en la mañana'. La lectura #11.4 que omite la palabra elimina la referencia temporal completamente.</div><div class="consensus-bar" style="max-width:200px"><div style="width:90%;background:#4caf50"></div></div><span style="font-size:0.72rem;color:#4caf50;font-weight:600;margin-left:4px">Confianza: alta</span><div class="tc-impact"><strong>Impacto:</strong> La diferencia entre 'primero' (πρῶτον/πρῶτος) y 'temprano' (πρωΐ) afecta significativamente el sentido: si Andrés encontró 'primero' a su hermano, implica una secuencia de acciones; si fue 'temprano', se refiere al tiempo del día.</div></div><div style="overflow-x:auto;margin-bottom:0.5rem"><table class="tc-table"><tr class="tc-header"><th class="tc-ms-col">MS</th><th class="tc-ctx">εὑρίσκει</th><th class="tc-ctx">οὗτος</th><th class="tc-var-col" title="Columna variante 1: πρῶτον">⚡1</th><th class="tc-ctx">τὸν</th><th class="tc-ctx">ἀδελφὸν</th></tr><tr><td class="tc-ms-cell" onclick="showMSSPanel('𝔓66, 75 א2 A B Θ Ψ 083 0233vid f1 f13 205 892 1243 l 253 l 672 l 673 l 1016 l 1074 l 1627 ita, aur, c, f, ff2, l, q vg syrp, h, pal? copsa, bo arm geo slav Epiphanius; Gaudentius')"><span class="ms-chip" style="background:#b71c1c;color:white;font-weight:700" data-s="𝔓66" onclick="event.stopPropagation();showMSInfo(this,'𝔓66');">𝔓66</span><span class="ms-chip" style="background:#e3f2fd;color:#1565c0" data-s="75" onclick="event.stopPropagation();showMSInfo(this,'75');">75</span><span class="ms-chip" style="background:#1565c0;color:white;font-weight:700" data-s="A" onclick="event.stopPropagation();showMSInfo(this,'A');">A</span><span class="ms-chip" style="background:#1565c0;color:white;font-weight:700" data-s="B" onclick="event.stopPropagation();showMSInfo(this,'B');">B</span><span class="ms-chip" style="background:#1565c0;color:white;font-weight:700" data-s="Θ" onclick="event.stopPropagation();showMSInfo(this,'Θ');">Θ</span><span class="ms-chip" style="background:#1565c0;color:white;font-weight:700" data-s="Ψ" onclick="event.stopPropagation();showMSInfo(this,'Ψ');">Ψ</span><span class="ms-chip" style="background:#1976d2;color:white" data-s="083" onclick