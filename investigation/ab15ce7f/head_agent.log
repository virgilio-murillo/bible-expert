ation();showMSInfo(this,'33');">33</span><span class="ms-chip" style="background:#e3f2fd;color:#1565c0" data-s="180" onclick="event.stopPropagation();showMSInfo(this,'180');">180</span><span class="ms-chip" style="background:#e3f2fd;color:#1565c0" data-s="205" onclick="event.stopPropagation();showMSInfo(this,'205');">205</span><span class="ms-chip" style="background:#e3f2fd;color:#1565c0" data-s="565" onclick="event.stopPropagation();showMSInfo(this,'565');">565</span><span class="ms-chip" style="background:#e3f2fd;color:#1565c0" data-s="579" onclick="event.stopPropagation();showMSInfo(this,'579');">579</span><span class="ms-chip" style="background:#e3f2fd;color:#1565c0" data-s="597" onclick="event.stopPropagation();showMSInfo(this,'597');">597</span><span class="ms-chip" style="background:#e3f2fd;color:#1565c0" data-s="700" onclick="event.stopPropagation();showMSInfo(this,'700');">700</span><span class="ms-chip" style="background:#e3f2fd;color:#1565c0" data-s="892" onclick="event.stopPropagation();showMSInfo(this,'892');">892</span><span class="ms-chip" style="background:#e3f2fd;color:#1565c0" data-s="1006" onclick="event.stopPropagation();showMSInfo(this,'1006');">1006</span><span class="ms-chip" style="background:#e3f2fd;color:#1565c0" data-s="1010" onclick="event.stopPropagation();showMSInfo(this,'1010');">1010</span><span class="ms-chip" style="background:#e3f2fd;color:#1565c0" data-s="1071" onclick="event.stopPropagation();showMSInfo(this,'1071');">1071</span><span class="ms-chip" style="background:#e3f2fd;color:#1565c0" data-s="1241" onclick="event.stopPropagation();showMSInfo(this,'1241');">1241</span><span class="ms-chip" style="background:#e3f2fd;color:#1565c0" data-s="1243" onclick="event.stopPropagation();showMSInfo(this,'1243');">1243</span><span class="ms-chip" style="background:#e3f2fd;color:#1565c0" data-s="1292" onclick="event.stopPropagation();showMSInfo(this,'1292');">1292</span><span class="ms-chip" style="background:#e3f2fd;color:#1565c0" data-s="1342" onclick="event.stopPropagation();showMSInfo(this,'1342');">1342</span><span class="ms-chip" style="background:#e3f2fd;color:#1565c0" data-s="1424" onclick="event.stopPropagation();showMSInfo(this,'1424');">1424</span><span class="ms-chip" style="background:#e3f2fd;color:#1565c0" data-s="1505" onclick="event.stopPropagation();showMSInfo(this,'1505');">1505</span><span class="ms-chip" style="background:#2e7d32;color:white" data-s="Byz" onclick="event.stopPropagation();showMSInfo(this,'Byz');">Byz</span><span class="ms-chip" style="background:#1565c0;color:white;font-weight:700" data-s="E" onclick="event.stopPropagation();showMSInfo(this,'E');">E</span><span class="ms-chip" style="background:#1565c0;color:white;font-weight:700" data-s="F" onclick="event.stopPropagation();showMSInfo(this,'F');">F</span><span class="ms-chip" style="background:#1565c0;color:white;font-weight:700" data-s="G" onclick="event.stopPropagation();showMSInfo(this,'G');">G</span><span class="ms-chip" style="background:#1565c0;color:white;font-weight:700" data-s="H" onclick="event.stopPropagation();showMSInfo(this,'H');">H</span><span class="ms-chip" style="background:#2e7d32;color:white" data-s="Lect" onclick="event.stopPropagation();showMSInfo(this,'Lect');">Lect</span><span class="ms-chip" style="background:#f3e5f5;color:#6a1b9a" data-s="vg" onclick="event.stopPropagation();showMSInfo(this,'vg');">vg</span><span class="ms-chip" style="background:#f3e5f5;color:#6a1b9a" data-s="syrp" onclick="event.stopPropagation();showMSInfo(this,'syrp');">syrp</span><span class="ms-chip" style="" data-s="h" onclick="event.stopPropagation();showMSInfo(this,'h');">h</span><span class="ms-chip" style="background:#f3e5f5;color:#6a1b9a" data-s="copbo" onclick="event.stopPropagation();showMSInfo(this,'copbo');">copbo</span><span class="ms-chip" style="background:#f3e5f5;color:#6a1b9a" data-s="arm" onclick="event.stopPropagation();showMSInfo(this,'arm');">arm</span><span class="ms-chip" style="background:#f3e5