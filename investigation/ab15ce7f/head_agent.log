ck="event.stopPropagation();showMSInfo(this,'1342');">1342</span><span class="ms-chip" style="background:#e3f2fd;color:#1565c0" data-s="1505" onclick="event.stopPropagation();showMSInfo(this,'1505');">1505</span><span class="ms-chip" style="background:#2e7d32;color:white" data-s="Byz" onclick="event.stopPropagation();showMSInfo(this,'Byz');">Byz</span><span class="ms-chip" style="background:#1565c0;color:white;font-weight:700" data-s="E" onclick="event.stopPropagation();showMSInfo(this,'E');">E</span><span class="ms-chip" style="background:#1565c0;color:white;font-weight:700" data-s="F" onclick="event.stopPropagation();showMSInfo(this,'F');">F</span><span class="ms-chip" style="background:#1565c0;color:white;font-weight:700" data-s="G" onclick="event.stopPropagation();showMSInfo(this,'G');">G</span><span class="ms-chip" style="background:#1565c0;color:white;font-weight:700" data-s="H" onclick="event.stopPropagation();showMSInfo(this,'H');">H</span><span class="ms-chip" style="background:#2e7d32;color:white" data-s="Lect" onclick="event.stopPropagation();showMSInfo(this,'Lect');">Lect</span><span class="ms-chip" style="background:#fff3e0;color:#e65100" data-s="Chrysostomlem" onclick="event.stopPropagation();showMSInfo(this,'Chrysostomlem');">Chrysostomlem</span><span class="ms-chip" style="background:#fff3e0;color:#e65100" data-s="Cyrillem" onclick="event.stopPropagation();showMSInfo(this,'Cyrillem');">Cyrillem</span></td><td class="tc-word-cell tc-interactive" style="background:#f5f5f5" data-tip="Está hallando" data-lemma="εὑρίσκω" data-morph="V-PAI-3S" data-strongs="G2147">εὑρίσκει</td><td class="tc-word-cell tc-interactive" style="background:#f5f5f5" data-tip="este" data-lemma="οὗτος" data-morph="D-NSM" data-strongs="G3778">οὗτος</td><td class="tc-word-cell tc-interactive" style="background:#ffe0b2" data-tip="primero" data-lemma="πρῶτος" data-morph="A-NSM" data-strongs="G4413">πρῶτος</td><td class="tc-word-cell tc-interactive" style="background:#f5f5f5" data-tip="