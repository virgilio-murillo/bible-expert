def box(ax, x, y, w, h, label, color, fontsize=9, textcolor='white', sublabel=None):
    p = FancyBboxPatch((x, y), w, h, boxstyle='round,pad=0.15', fc=color, ec='white', lw=1.5)
    ax.add_patch(p)
    cy = y + h/2 + (0.15 if sublabel else 0)
    ax.text(x + w/2, cy, label, ha='center', va='center', color=textcolor,
            fontsize=fontsize, fontweight='bold', wrap=True)
    if sublabel:
        ax.text(x + w/2, y + h/2 - 0.25, sublabel, ha='center', va='center',
                color='#aaaacc', fontsize=7.5)

def arrow(ax, x1, y1, x2, y2, label='', color='white'):
    ax.annotate('', xy=(x2, y2), xytext=(x1, y1),
                arrowprops=dict(arrowstyle='-|>', color=color, lw=1.8))
