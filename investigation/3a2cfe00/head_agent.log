            date_approx TEXT,
            source_collection TEXT   -- ANF, NPNF1, NPNF2, Catena
        );
        CREATE INDEX IF NOT EXISTS idx_patristic_ref ON patristic(book, chapter, verse_num);
        CREATE INDEX IF NOT EXISTS idx_patristic_father ON patristic(father);

